--- a/dlls/xgameruntime/private.h
+++ b/dlls/xgameruntime/private.h
@@ -95,3 +95,15 @@
 extern IXUserDeviceImpl *x_user_device_impl;
 
 HRESULT WINAPI QueryApiImpl( const GUID *classId, REFIID interfaceId, void **out );
+
+/* Xodus honest-offline gate.
+ * Xodus has no authenticated Xbox Live identity or service path by default, so the
+ * online sign-in / connectivity seam must resolve promptly to a signed-out / offline
+ * result instead of hanging a title indefinitely at "connecting". Opt in to the real
+ * (honest, user-authenticated) online attempt by setting XODUS_XBL_ONLINE=1. */
+static inline BOOL xodus_xbl_online_enabled(void)
+{
+    char value[8];
+    DWORD len = GetEnvironmentVariableA( "XODUS_XBL_ONLINE", value, sizeof(value) );
+    return len >= 1 && len < sizeof(value) && value[0] == '1';
+}
--- a/dlls/xgameruntime/xnetworking.c
+++ b/dlls/xgameruntime/xnetworking.c
@@ -183,10 +183,19 @@
     }
     cached.connectivityLevel = connected ? XNetworkingConnectivityLevelHint_InternetAccess :
                                           XNetworkingConnectivityLevelHint_None;
+    if (!xodus_xbl_online_enabled() && cached.connectivityLevel == XNetworkingConnectivityLevelHint_InternetAccess)
+    {
+        /* Honest offline: the host has raw internet, but Xodus has no authenticated Xbox
+         * Live service path (no identity, no tokens). Report local-only reachability so
+         * titles stop waiting on an Xbox Live connection they cannot complete and fall
+         * through to single-player. Set XODUS_XBL_ONLINE=1 to attempt the real path. */
+        cached.connectivityLevel = XNetworkingConnectivityLevelHint_LocalAccess;
+        WARN_(gdkc)( "Xodus honest offline: reporting LocalAccess (no authenticated Xbox Live path).\n" );
+    }
     measured_at = now;
     *connectivityHint = cached;
     ReleaseSRWLockExclusive( &lock );
-    TRACE( "iface %p, measured host connectivity %u, cost unknown.\n", iface, connectivityHint->connectivityLevel );
+    WARN_(gdkc)( "XNetworkingGetConnectivityHint -> level %u cost %u.\n", cached.connectivityLevel, cached.connectivityCost );
     return S_OK;
 }
 
