+/* Fast local creation owns its template data through the existing binding,
+ * authentication, QOS and association lifetimes. No server is contacted here. */
+RPC_STATUS WINAPI RpcBindingCreateW(RPC_BINDING_HANDLE_TEMPLATE_V1_W *template,
+    RPC_BINDING_HANDLE_SECURITY_V1_W *security, RPC_BINDING_HANDLE_OPTIONS_V1 *options,
+    RPC_BINDING_HANDLE *result)
+{
+    RPC_SECURITY_QOS defaults = {1, RPC_C_QOS_CAPABILITIES_DEFAULT,
+        RPC_C_QOS_IDENTITY_STATIC, RPC_C_IMP_LEVEL_IMPERSONATE};
+    RPC_SECURITY_QOS *qos = security && security->SecurityQos ? security->SecurityQos : &defaults;
+    RPC_BINDING_HANDLE handle = NULL;
+    RPC_WSTR string = NULL;
+    RpcBinding *binding;
+    HANDLE token = NULL;
+    RPC_STATUS status;
+    ULONG level = security ? security->AuthnLevel : RPC_C_AUTHN_LEVEL_PKT_PRIVACY;
+    ULONG service = security ? security->AuthnSvc : RPC_C_AUTHN_WINNT;
+
+    if (!result) return ERROR_INVALID_PARAMETER;
+    *result = NULL;
+    if (!template || template->Version != 1 || template->Flags & ~1 ||
+        template->u1.Reserved || (security && security->Version != 1) ||
+        (options && options->Version != 1))
+        return ERROR_INVALID_PARAMETER;
+    if (template->ProtocolSequence != 3) return RPC_S_CANNOT_SUPPORT;
+    if (template->NetworkAddress && template->NetworkAddress[0])
+        return RPC_S_CANNOT_SUPPORT;
+    if (options && (options->Flags || options->CallTimeout ||
+        options->ComTimeout != RPC_C_BINDING_DEFAULT_TIMEOUT))
+    {
+        WARN("fast local options unsupported: flags %#lx com %lu call %lu\n",
+            options->Flags, options->ComTimeout, options->CallTimeout);
+        return RPC_S_CANNOT_SUPPORT;
+    }
+    if (qos->Version != 1 || qos->Capabilities ||
+        qos->IdentityTracking > RPC_C_QOS_IDENTITY_DYNAMIC ||
+        (qos->ImpersonationType != RPC_C_IMP_LEVEL_IDENTIFY &&
+         qos->ImpersonationType != RPC_C_IMP_LEVEL_IMPERSONATE) ||
+        (security && security->AuthIdentity))
+    {
+        WARN("fast local security/QOS feature unsupported\n");
+        return RPC_S_CANNOT_SUPPORT;
+    }
+    if (service == RPC_C_AUTHN_DEFAULT) service = RPC_C_AUTHN_WINNT;
+    if (level == RPC_C_AUTHN_LEVEL_DEFAULT && service != RPC_C_AUTHN_NONE)
+        level = RPC_C_AUTHN_LEVEL_PKT_PRIVACY;
+    if (service != RPC_C_AUTHN_NONE && service != RPC_C_AUTHN_WINNT)
+        return RPC_S_CANNOT_SUPPORT;
+    if (service == RPC_C_AUTHN_NONE && level != 0 && level != RPC_C_AUTHN_LEVEL_NONE)
+        return ERROR_INVALID_PARAMETER;
+    if (service != RPC_C_AUTHN_NONE && level == RPC_C_AUTHN_LEVEL_NONE)
+        return ERROR_INVALID_PARAMETER;
+    status = RpcStringBindingComposeW(NULL, (RPC_WSTR)L"ncalrpc", template->NetworkAddress,
+                                     template->StringEndpoint, NULL, &string);
+    if (status) return status;
+    status = RpcBindingFromStringBindingW(string, &handle);
+    RpcStringFreeW(&string);
+    if (status) return status;
+    binding = handle;
+    if (template->Flags & 1)
+        status = RpcBindingSetObject(handle, &template->ObjectUuid);
+    if (!status)
+        status = RpcBindingSetAuthInfoExW(handle, security ? security->ServerPrincName : NULL,
+            level, service, NULL, RPC_C_AUTHZ_NONE, qos);
+    if (status) goto failed;
+    binding->QOS->effective_only = !security;
+    if (qos->IdentityTracking == RPC_C_QOS_IDENTITY_STATIC)
+    {
+        if (!OpenThreadToken(GetCurrentThread(), TOKEN_QUERY | TOKEN_DUPLICATE, TRUE, &token))
+        {
+            if (GetLastError() != ERROR_NO_TOKEN ||
+                !OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &token))
+            {
+                status = RPC_S_ACCESS_DENIED;
+                goto failed;
+            }
+        }
+        if (!DuplicateTokenEx(token, TOKEN_QUERY | TOKEN_IMPERSONATE | TOKEN_DUPLICATE,
+                             NULL, SecurityImpersonation, TokenImpersonation,
+                             &binding->QOS->fast_local_token))
+            status = RPC_S_ACCESS_DENIED;
+        CloseHandle(token);
+        if (status) goto failed;
+    }
+    binding->fast_static = template->StringEndpoint && template->StringEndpoint[0];
+    TRACE("fast local binding created, static endpoint %u identity %lu auth %lu/%lu\n",
+          binding->fast_static, qos->IdentityTracking, level, service);
+    *result = handle;
+    return RPC_S_OK;
+failed:
+    RpcBindingFree(&handle);
+    return status;
 }
 
