+HRESULT application_data_folder_create( const WCHAR *leaf, IStorageFolder **out )
+{
+    struct storage_folder *impl;
+    WCHAR *family = NULL, *local = NULL, *path = NULL;
+    UINT32 family_len = 0;
+    SIZE_T path_len;
+    LONG status;
+    int error;
+    DWORD attributes;
+    HRESULT hr;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    status = GetCurrentPackageFamilyName( &family_len, NULL );
+    if (status != ERROR_INSUFFICIENT_BUFFER)
+    {
+        WARN( "Package family sizing failed: %ld.\n", status );
+        return HRESULT_FROM_WIN32( status ? status : ERROR_INVALID_DATA );
+    }
+    if (!(family = calloc( family_len, sizeof(*family) ))) return E_OUTOFMEMORY;
+    status = GetCurrentPackageFamilyName( &family_len, family );
+    if (status)
+    {
+        WARN( "Package family query failed: %ld.\n", status );
+        hr = HRESULT_FROM_WIN32( status );
+        goto done;
+    }
+    if (FAILED(hr = SHGetKnownFolderPath( &FOLDERID_LocalAppData, KF_FLAG_CREATE, NULL, &local )))
+        goto done;
+    path_len = wcslen(local) + wcslen(L"\\Packages\\") + wcslen(family) + 1 + wcslen(leaf) + 1;
+    if (!(path = calloc( path_len, sizeof(*path) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    swprintf( path, path_len, L"%s\\Packages\\%s\\%s", local, family, leaf );
+    error = SHCreateDirectoryExW( NULL, path, NULL );
+    if (error && error != ERROR_ALREADY_EXISTS && error != ERROR_FILE_EXISTS)
+    {
+        WARN( "Directory creation failed for %s: %d.\n", debugstr_w(path), error );
+        hr = HRESULT_FROM_WIN32( error );
+        goto done;
+    }
+    attributes = GetFileAttributesW( path );
+    if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        WARN( "Folder path is not a directory: %s.\n", debugstr_w(path) );
+        hr = HRESULT_FROM_WIN32( ERROR_DIRECTORY );
+        goto done;
+    }
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    impl->IStorageFolder_iface.lpVtbl = &storage_folder_vtbl;
+    impl->IStorageItem_iface.lpVtbl = &storage_item_vtbl;
+    impl->ref = 1;
+    hr = WindowsCreateString( path, wcslen(path), &impl->path );
+    if (SUCCEEDED(hr)) hr = WindowsCreateString( leaf, wcslen(leaf), &impl->name );
+    if (FAILED(hr)) IStorageFolder_Release( &impl->IStorageFolder_iface );
+    else
+    {
+        *out = &impl->IStorageFolder_iface;
+        TRACE( "created folder %s.\n", debugstr_w(path) );
+    }
+done:
+    free( path );
+    CoTaskMemFree( local );
+    free( family );
+    return hr;
+}
