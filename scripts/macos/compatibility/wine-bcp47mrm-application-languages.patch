+static HRESULT user_languages(WCHAR **result)
+{
+    WCHAR *buffer = NULL, *next, *cursor;
+    ULONG count = 0, chars = 0;
+    DWORD error;
+    unsigned int attempt;
+
+    *result = NULL;
+    for (attempt = 0; attempt < 3; ++attempt)
+    {
+        SetLastError(ERROR_SUCCESS);
+        if (!GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, NULL, &chars))
+            return language_api_error("GetUserPreferredUILanguages(size)");
+        if (!count || chars < 2) break;
+        if (!(buffer = calloc(chars, sizeof(*buffer)))) return E_OUTOFMEMORY;
+        SetLastError(ERROR_SUCCESS);
+        if (GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, buffer, &chars)) break;
+        error = GetLastError();
+        free(buffer);
+        buffer = NULL;
+        if (error != ERROR_INSUFFICIENT_BUFFER || attempt == 2)
+        {
+            SetLastError(error);
+            return language_api_error("GetUserPreferredUILanguages(fill)");
+        }
+    }
+    if (!buffer || !buffer[0])
+    {
+        free(buffer);
+        if (!(buffer = calloc(LOCALE_NAME_MAX_LENGTH, sizeof(*buffer)))) return E_OUTOFMEMORY;
+        SetLastError(ERROR_SUCCESS);
+        if (!GetUserDefaultLocaleName(buffer, LOCALE_NAME_MAX_LENGTH))
+        {
+            HRESULT hr = language_api_error("GetUserDefaultLocaleName");
+            free(buffer);
+            return hr;
+        }
+        if (!buffer[0])
+        {
+            ERR("Both user language sources are empty.\n");
+            free(buffer);
+            return E_UNEXPECTED;
+        }
+    }
+    else
+    {
+        for (cursor = buffer; *cursor; cursor = next)
+        {
+            next = cursor + lstrlenW(cursor) + 1;
+            if (*next) next[-1] = ';';
+        }
+    }
+    *result = buffer;
     return S_OK;
 }
 
-LONG WINAPI GetApplicationLayoutDirection(void)
+HRESULT WINAPI GetApplicationLanguagesWithUserLanguagesFallback(PCWSTR package_fullname, SIZE_T *length,
+                                                                 WCHAR *buffer)
 {
-    FIXME("semi-stub: returning 0 (LTR)\n");
-    return 0;
+    SIZE_T capacity, required;
+    WCHAR *languages;
+    HRESULT hr;
+
+    FIXME("package %s: no per-package manifest/registry language selection or fallback matching.\n",
+          debugstr_w(package_fullname));
+    if (!length) return E_POINTER;
+    capacity = *length;
+    if (FAILED(hr = user_languages(&languages))) return hr;
+    required = (SIZE_T)lstrlenW(languages) + 1;
+    *length = required;
+    if (!buffer || capacity < required)
+        hr = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    else
+    {
+        memcpy(buffer, languages, required * sizeof(*buffer));
+        FIXME("User-language subset: %s, required/written %Iu WCHARs.\n", debugstr_w(languages), required);
+    }
+    free(languages);
+    return hr;
+}
+
+HRESULT WINAPI GetApplicationLayoutDirection(PCWSTR languages, DWORD *direction)
+{
+    WCHAR *owned = NULL;
+    WCHAR first, second;
+    HRESULT hr;
+
+    FIXME("languages %s: limited ar/he/fa/ur primary-subtag RTL table; no package-language lookup.\n",
+          debugstr_w(languages));
+    if (!direction) return E_POINTER;
+    *direction = ~0u;
+    if (!languages || !*languages)
+    {
+        if (FAILED(hr = user_languages(&owned))) return hr;
+        languages = owned;
+    }
+    first = languages[0];
+    second = languages[1];
+    if (first >= 'A' && first <= 'Z') first += 'a' - 'A';
+    if (second >= 'A' && second <= 'Z') second += 'a' - 'A';
+    *direction = 0;
+    if (second && (!languages[2] || languages[2] == '-' || languages[2] == ';'))
+        if ((first == 'a' && second == 'r') || (first == 'h' && second == 'e') ||
+            (first == 'f' && second == 'a') || (first == 'u' && second == 'r'))
+            *direction = 1;
+    FIXME("Selected layout direction %lu.\n", *direction);
+    free(owned);
+    return S_OK;
 }
 
