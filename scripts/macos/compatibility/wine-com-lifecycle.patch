 static CRITICAL_SECTION apt_cs = { &apt_cs_debug, -1, 0, 0, 0, 0 };
+
+struct shutdown_registration
+{
+    struct list entry;
+    struct apartment *apt;
+    IApartmentShutdown *callback;
+    ULONG_PTR cookie;
+};
+
+static struct list shutdown_registrations = LIST_INIT(shutdown_registrations);
+static ULONG_PTR next_shutdown_cookie;
+
+HRESULT apartment_register_shutdown_callback(IApartmentShutdown *callback,
+                                             UINT64 *identifier, void **cookie)
+{
+    struct shutdown_registration *registration;
+    struct apartment *apt;
+    IAgileObject *agile;
+    HRESULT hr;
+
+    if (!callback || !identifier || !cookie) return E_INVALIDARG;
+    *identifier = 0;
+    *cookie = NULL;
+    if (!(apt = apartment_get_current_or_mta())) return CO_E_NOTINITIALIZED;
+    hr = IApartmentShutdown_QueryInterface(callback, &IID_IAgileObject, (void **)&agile);
+    if (FAILED(hr))
+    {
+        apartment_release(apt);
+        return RO_E_MUST_BE_AGILE;
+    }
+    IAgileObject_Release(agile);
+    if (!(registration = malloc(sizeof(*registration))))
+    {
+        apartment_release(apt);
+        return E_OUTOFMEMORY;
+    }
+    IApartmentShutdown_AddRef(callback);
+    EnterCriticalSection(&apt_cs);
+    if (apt->being_destroyed || next_shutdown_cookie == ~(ULONG_PTR)0)
+    {
+        LeaveCriticalSection(&apt_cs);
+        IApartmentShutdown_Release(callback);
+        free(registration);
+        apartment_release(apt);
+        return E_UNEXPECTED;
+    }
+    registration->apt = apt;
+    registration->callback = callback;
+    registration->cookie = ++next_shutdown_cookie;
+    list_add_tail(&shutdown_registrations, &registration->entry);
+    *identifier = apartment_getoxid(apt);
+    *cookie = (void *)registration->cookie;
+    LeaveCriticalSection(&apt_cs);
+    apartment_release(apt);
+    return S_OK;
+}
+
+HRESULT apartment_unregister_shutdown_callback(void *cookie)
+{
+    struct shutdown_registration *registration, *found = NULL;
+    if (!cookie) return E_INVALIDARG;
+    EnterCriticalSection(&apt_cs);
+    LIST_FOR_EACH_ENTRY(registration, &shutdown_registrations, struct shutdown_registration, entry)
+    {
+        if (registration->cookie == (ULONG_PTR)cookie)
+        {
+            found = registration;
+            list_remove(&registration->entry);
+            break;
+        }
+    }
+    LeaveCriticalSection(&apt_cs);
+    if (!found) return HRESULT_FROM_WIN32(ERROR_INVALID_HANDLE);
+    IApartmentShutdown_Release(found->callback);
+    free(found);
+    return S_OK;
+}
+
+static void apartment_notify_shutdown(struct apartment *apt)
+{
+    struct shutdown_registration *registration, *next;
+    struct list callbacks = LIST_INIT(callbacks);
+    EnterCriticalSection(&apt_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(registration, next, &shutdown_registrations,
+                            struct shutdown_registration, entry)
+    {
+        if (registration->apt == apt)
+        {
+            list_remove(&registration->entry);
+            list_add_tail(&callbacks, &registration->entry);
+        }
+    }
+    LeaveCriticalSection(&apt_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(registration, next, &callbacks, struct shutdown_registration, entry)
+    {
+        list_remove(&registration->entry);
+        IApartmentShutdown_OnUninitialize(registration->callback, apartment_getoxid(apt));
+        IApartmentShutdown_Release(registration->callback);
+        free(registration);
+    }
+}
 
