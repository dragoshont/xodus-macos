+HRESULT WINAPI CoRegisterForApartmentShutdown(IApartmentShutdown *listener, UINT64 *identifier,
+        APARTMENT_SHUTDOWN_REGISTRATION_COOKIE *cookie)
+{
+    struct shutdown_registration *registration;
+    struct apartment *apt;
+    IAgileObject *agile;
+    HRESULT hr;
+
+    TRACE("(%p, %p, %p)\n", listener, identifier, cookie);
+    if (!(apt = apartment_get_current_or_mta())) return CO_E_NOTINITIALIZED;
+    if (!listener || !identifier || !cookie)
+    {
+        apartment_release(apt);
+        return E_POINTER; /* defensive divergence from native invalid-pointer faults */
+    }
+    *identifier = apt->identifier;
+    *cookie = NULL;
+    hr = IApartmentShutdown_QueryInterface(listener, &IID_IAgileObject, (void **)&agile);
+    if (FAILED(hr))
+    {
+        WARN("Shutdown listener is not agile, hr %#lx.\n", hr);
+        apartment_release(apt);
+        return RO_E_MUST_BE_AGILE;
+    }
+    IAgileObject_Release(agile);
+    if (!(registration = malloc(sizeof(*registration))))
+    {
+        apartment_release(apt);
+        return E_OUTOFMEMORY;
+    }
+    registration->listener = listener;
+    IApartmentShutdown_AddRef(listener);
+    EnterCriticalSection(&apt_cs);
+    if (apt->being_destroyed || next_shutdown_cookie == ~(ULONG_PTR)0)
+    {
+        hr = apt->being_destroyed ? E_UNEXPECTED : E_OUTOFMEMORY;
+        LeaveCriticalSection(&apt_cs);
+        IApartmentShutdown_Release(listener);
+        free(registration);
+        apartment_release(apt);
+        return hr;
+    }
+    registration->cookie = ++next_shutdown_cookie;
+    list_add_tail(&apt->shutdown_registrations, &registration->entry);
+    *cookie = (APARTMENT_SHUTDOWN_REGISTRATION_COOKIE)registration->cookie;
+    LeaveCriticalSection(&apt_cs);
+    apartment_release(apt);
+    return S_OK;
+}
+
+HRESULT WINAPI CoUnregisterForApartmentShutdown(APARTMENT_SHUTDOWN_REGISTRATION_COOKIE cookie)
+{
+    struct shutdown_notification *notification;
+    struct shutdown_registration *registration, *found = NULL;
+    struct apartment *apt;
+
+    TRACE("(%p)\n", cookie);
+    /* Teardown can have removed the MTA from the global list already. */
+    EnterCriticalSection(&apt_cs);
+    LIST_FOR_EACH_ENTRY(notification, &shutdown_notifications, struct shutdown_notification, entry)
+    {
+        if (notification->tid == GetCurrentThreadId())
+        {
+            LeaveCriticalSection(&apt_cs);
+            return E_UNEXPECTED;
+        }
+    }
+    LeaveCriticalSection(&apt_cs);
+    if (!(apt = apartment_get_current_or_mta())) return CO_E_NOTINITIALIZED;
+    EnterCriticalSection(&apt_cs);
+    if (apt->being_destroyed)
+    {
+        LeaveCriticalSection(&apt_cs);
+        apartment_release(apt);
+        return E_UNEXPECTED;
+    }
+    LIST_FOR_EACH_ENTRY(registration, &apt->shutdown_registrations, struct shutdown_registration, entry)
+    {
+        if (registration->cookie == (ULONG_PTR)cookie)
+        {
+            list_remove(&registration->entry);
+            found = registration;
+            break;
+        }
+    }
+    LeaveCriticalSection(&apt_cs);
+    if (found)
+    {
+        IApartmentShutdown_Release(found->listener);
+        free(found);
+    }
+    apartment_release(apt);
+    return found ? S_OK : E_INVALIDARG;
+}
