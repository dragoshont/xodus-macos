+static void apartment_notify_shutdown(struct apartment *apt)
+{
+    struct shutdown_notification notification;
+    struct shutdown_registration *registration;
+    struct list *entry;
+
+    notification.tid = GetCurrentThreadId();
+    EnterCriticalSection(&apt_cs);
+    list_add_tail(&shutdown_notifications, &notification.entry);
+    LeaveCriticalSection(&apt_cs);
+
+    for (;;)
+    {
+        EnterCriticalSection(&apt_cs);
+        entry = list_head(&apt->shutdown_registrations);
+        if (entry) list_remove(entry);
+        LeaveCriticalSection(&apt_cs);
+        if (!entry) break;
+
+        registration = LIST_ENTRY(entry, struct shutdown_registration, entry);
+        /* Never hold apt_cs across user code; protect the listener while notifying. */
+        IApartmentShutdown_AddRef(registration->listener);
+        IApartmentShutdown_OnUninitialize(registration->listener, apt->identifier);
+        IApartmentShutdown_Release(registration->listener);
+        IApartmentShutdown_Release(registration->listener);
+        free(registration);
+    }
+
+    EnterCriticalSection(&apt_cs);
+    list_remove(&notification.entry);
+    LeaveCriticalSection(&apt_cs);
+}
