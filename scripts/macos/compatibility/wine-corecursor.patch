+#include <stdlib.h>
+#include "private.h"
+#include "objbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+struct corecursor
+{
+    ICoreCursor ICoreCursor_iface;
+    LONG ref;
+    CoreCursorType type;
+    UINT32 id;
+};
+
+struct corecursor_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    ICoreCursorFactory ICoreCursorFactory_iface;
+    LONG ref;
+};
+
+static HRESULT cursor_iids( const IID *const *supported, ULONG count, ULONG *iid_count, IID **iids )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    *iid_count = 0;
+    *iids = CoTaskMemAlloc( count * sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i) (*iids)[i] = *supported[i];
+    *iid_count = count;
+    return S_OK;
+}
+
+static HRESULT cursor_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_UI_Core_CoreCursor;
+
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen(class_name), name );
+}
+
+static HRESULT cursor_trust_level( TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static struct corecursor *impl_from_ICoreCursor( ICoreCursor *iface )
+{
+    return CONTAINING_RECORD( iface, struct corecursor, ICoreCursor_iface );
+}
+
+static HRESULT WINAPI cursor_QueryInterface( ICoreCursor *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_ICoreCursor))
+    {
+        *out = iface;
+        ICoreCursor_AddRef( iface );
+        return S_OK;
+    }
+    WARN( "unsupported interface %s.\n", debugstr_guid(iid) );
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cursor_AddRef( ICoreCursor *iface )
+{
+    return InterlockedIncrement( &impl_from_ICoreCursor(iface)->ref );
+}
+
+static ULONG WINAPI cursor_Release( ICoreCursor *iface )
+{
+    struct corecursor *impl = impl_from_ICoreCursor( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI cursor_GetIids( ICoreCursor *iface, ULONG *count, IID **iids )
+{
+    const IID *supported[] = { &IID_ICoreCursor, &IID_IAgileObject };
+    return cursor_iids( supported, ARRAY_SIZE(supported), count, iids );
+}
+
+static HRESULT WINAPI cursor_GetRuntimeClassName( ICoreCursor *iface, HSTRING *name )
+{
+    return cursor_class_name( name );
+}
+
+static HRESULT WINAPI cursor_GetTrustLevel( ICoreCursor *iface, TrustLevel *level )
+{
+    return cursor_trust_level( level );
+}
+
+static HRESULT WINAPI cursor_get_Id( ICoreCursor *iface, UINT32 *id )
+{
+    if (!id) return E_POINTER;
+    *id = impl_from_ICoreCursor(iface)->id;
+    TRACE( "iface %p, id %u.\n", iface, *id );
+    return S_OK;
+}
+
+static HRESULT WINAPI cursor_get_Type( ICoreCursor *iface, CoreCursorType *type )
+{
+    if (!type) return E_POINTER;
+    *type = impl_from_ICoreCursor(iface)->type;
+    TRACE( "iface %p, type %u.\n", iface, *type );
+    return S_OK;
+}
+
+static const ICoreCursorVtbl cursor_vtbl =
+{
+    cursor_QueryInterface,
+    cursor_AddRef,
+    cursor_Release,
+    cursor_GetIids,
+    cursor_GetRuntimeClassName,
+    cursor_GetTrustLevel,
+    cursor_get_Id,
+    cursor_get_Type,
+};
+
+static struct corecursor_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct corecursor_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct corecursor_factory *impl = impl_from_IActivationFactory( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID(iid, &IID_ICoreCursorFactory))
+        *out = &impl->ICoreCursorFactory_iface;
+    else
+    {
+        WARN( "unsupported factory interface %s.\n", debugstr_guid(iid) );
+        return E_NOINTERFACE;
+    }
+    IActivationFactory_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory(iface)->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory(iface)->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    const IID *supported[] = { &IID_IActivationFactory, &IID_ICoreCursorFactory, &IID_IAgileObject };
+    return cursor_iids( supported, ARRAY_SIZE(supported), count, iids );
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return cursor_class_name( name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    return cursor_trust_level( level );
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (!instance) return E_INVALIDARG;
+    *instance = NULL;
+    FIXME( "CoreCursor requires ICoreCursorFactory::CreateCursor, not default activation.\n" );
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( cursor_factory, ICoreCursorFactory, struct corecursor_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI cursor_factory_CreateCursor( ICoreCursorFactory *iface, CoreCursorType type,
+                                                   UINT32 id, ICoreCursor **cursor )
+{
+    struct corecursor *impl;
+
+    TRACE( "iface %p, type %u, id %u, cursor %p.\n", iface, type, id, cursor );
+    if (!cursor) return E_INVALIDARG;
+    *cursor = NULL;
+    if (type < CoreCursorType_Arrow || type > CoreCursorType_Person) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICoreCursor_iface.lpVtbl = &cursor_vtbl;
+    impl->ref = 1;
+    impl->type = type;
+    impl->id = id;
+    *cursor = &impl->ICoreCursor_iface;
+    FIXME( "CoreCursor stores type/id only; ICoreWindow::put_PointerCursor still needs SetCursor/LoadCursor wiring.\n" );
+    return S_OK;
+}
+
+static const ICoreCursorFactoryVtbl cursor_factory_vtbl =
+{
+    cursor_factory_QueryInterface,
+    cursor_factory_AddRef,
+    cursor_factory_Release,
+    cursor_factory_GetIids,
+    cursor_factory_GetRuntimeClassName,
+    cursor_factory_GetTrustLevel,
+    cursor_factory_CreateCursor,
+};
+
+static struct corecursor_factory factory =
+{
+    { &factory_vtbl },
+    { &cursor_factory_vtbl },
+    1,
+};
+
+IActivationFactory *corecursor_factory = &factory.IActivationFactory_iface;
