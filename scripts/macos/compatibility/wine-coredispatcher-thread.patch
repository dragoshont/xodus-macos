+static HRESULT WINAPI pump_PumpUntilSignaled( IUnknown *iface, HANDLE handle )
+{
+    struct dispatcher *impl = impl_from_IDispatcherPump( iface );
+    HANDLE handles[2];
+    DWORD count = 0, result;
+    MSG msg;
+
+    TRACE( "iface %p, handle %p, owner %lx.\n", iface, handle, impl->thread_id );
+    if (GetCurrentThreadId() != impl->thread_id) return RPC_E_WRONG_THREAD;
+    if (handle) handles[count++] = handle;
+    handles[count++] = impl->shutdown;
+    for (;;)
+    {
+        result = MsgWaitForMultipleObjectsEx( count, handles, INFINITE, QS_ALLINPUT, MWMO_INPUTAVAILABLE );
+        if (result == WAIT_FAILED)
+        {
+            DWORD error = GetLastError();
+            WARN( "dispatcher wait failed, error %lu.\n", error );
+            return HRESULT_FROM_WIN32( error );
+        }
+        if (handle && result == WAIT_OBJECT_0) return S_OK;
+        if (result == WAIT_OBJECT_0 + count - 1) return E_APPLICATION_EXITING;
+        if (result != WAIT_OBJECT_0 + count)
+        {
+            WARN( "unexpected dispatcher wait result %#lx.\n", result );
+            return E_UNEXPECTED;
+        }
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE ))
+        {
+            if (msg.message == WM_QUIT) return E_APPLICATION_EXITING;
+            TranslateMessage( &msg );
+            DispatchMessageW( &msg );
+            /* Recheck handles between messages, including under sustained input. */
+            result = WaitForMultipleObjects( count, handles, FALSE, 0 );
+            if (handle && result == WAIT_OBJECT_0) return S_OK;
+            if (result == WAIT_OBJECT_0 + count - 1) return E_APPLICATION_EXITING;
+            if (result == WAIT_FAILED)
+            {
+                DWORD error = GetLastError();
+                WARN( "dispatcher handle check failed, error %lu.\n", error );
+                return HRESULT_FROM_WIN32( error );
+            }
+        }
+    }
+}
+
+static HRESULT WINAPI pump_BeginShutdown( IUnknown *iface )
+{
+    struct dispatcher *impl = impl_from_IDispatcherPump( iface );
+    TRACE( "iface %p.\n", iface );
+    if (!SetEvent( impl->shutdown ))
+    {
+        DWORD error = GetLastError();
+        WARN( "dispatcher shutdown signal failed, error %lu.\n", error );
+        return HRESULT_FROM_WIN32( error );
+    }
+    return S_OK;
+}
