+static HRESULT WINAPI dispatcher_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = iface;
+    else if (IsEqualGUID( iid, &IID_IDispatcherFactory_wine ))
+        *out = &dispatcher_statics.IDispatcherFactory_iface;
+    else return E_NOINTERFACE;
+    IActivationFactory_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI dispatcher_factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &dispatcher_statics.ref );
+}
+
+static ULONG WINAPI dispatcher_factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &dispatcher_statics.ref );
+}
+
+static HRESULT WINAPI dispatcher_factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( 2 * sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IActivationFactory;
+    (*iids)[1] = IID_IDispatcherFactory_wine;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI dispatcher_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    *name = NULL;
+    return E_ILLEGAL_METHOD_CALL;
+}
+
+static HRESULT WINAPI dispatcher_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = FullTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI dispatcher_factory_ActivateInstance( IActivationFactory *iface, IInspectable **out )
+{
+    if (!out) return E_POINTER;
