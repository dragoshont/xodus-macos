+static INIT_ONCE dispatcher_once = INIT_ONCE_STATIC_INIT;
+static DWORD dispatcher_tls = TLS_OUT_OF_INDEXES;
+
+void coredispatcher_thread_detach(void)
+{
+    struct dispatcher *impl;
+    if (dispatcher_tls == TLS_OUT_OF_INDEXES) return;
+    if ((impl = TlsGetValue( dispatcher_tls )))
+    {
+        TlsSetValue( dispatcher_tls, NULL );
+        ICoreDispatcher_Release( &impl->ICoreDispatcher_iface );
+    }
+}
+
+static BOOL CALLBACK dispatcher_init( INIT_ONCE *once, void *param, void **context )
+{
+    dispatcher_tls = TlsAlloc();
+    return dispatcher_tls != TLS_OUT_OF_INDEXES;
+}
+
+static HRESULT dispatcher_for_thread( BOOL create, ICoreDispatcher **out )
+{
+    struct dispatcher *impl;
+    DWORD error;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!InitOnceExecuteOnce( &dispatcher_once, dispatcher_init, NULL, NULL ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(impl = TlsGetValue( dispatcher_tls )) && create)
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->ICoreDispatcher_iface.lpVtbl = &dispatcher_vtbl;
+        impl->IDispatcherPump_iface.lpVtbl = (const IUnknownVtbl *)&pump_vtbl;
+        impl->ref = 1; /* TLS owns the reference until DLL_THREAD_DETACH. */
+        impl->thread_id = GetCurrentThreadId();
+        list_init( &impl->queue );
+        if (!(impl->shutdown = CreateEventW( NULL, TRUE, FALSE, NULL )))
+        {
+            error = GetLastError();
+            free( impl );
+            return HRESULT_FROM_WIN32( error );
+        }
+        InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+        impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": dispatcher.cs");
+        if (!TlsSetValue( dispatcher_tls, impl ))
+        {
+            error = GetLastError();
+            dispatcher_Release( &impl->ICoreDispatcher_iface );
+            return HRESULT_FROM_WIN32( error );
+        }
+        TRACE( "created thread dispatcher %p, owner %lx.\n", impl, impl->thread_id );
+    }
+    if (impl)
+    {
+        *out = &impl->ICoreDispatcher_iface;
+        ICoreDispatcher_AddRef( *out );
+    }
+    return S_OK;
+}
