+static HRESULT WINAPI adapter_SetWindowClientAdapter( ICoreWindowAdapterInteropWine *iface, IUnknown *value )
+{
+    struct corewindow *impl = impl_from_ICoreWindowAdapterInteropWine( iface );
+    IUnknown *previous;
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (value) IUnknown_AddRef( value );
+    EnterCriticalSection( &impl->cs );
+    previous = impl->client_adapter;
+    impl->client_adapter = value;
+    LeaveCriticalSection( &impl->cs );
+    if (previous) IUnknown_Release( previous );
+    return S_OK;
+}
