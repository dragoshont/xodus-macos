+static inline struct uicontext *impl_from_context( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct uicontext, IInspectable_iface );
+}
+
+static HRESULT WINAPI context_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IAgileObject ) && !IsEqualGUID( iid, &IID_IUIContext_wine ))
+        return E_NOINTERFACE;
+    *out = iface;
+    IInspectable_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI context_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_context(iface)->ref );
+}
+
+static ULONG WINAPI context_Release( IInspectable *iface )
+{
+    struct uicontext *impl = impl_from_context(iface);
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI context_GetIids( IInspectable *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    **iids = IID_IUIContext_wine;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI context_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    TRACE( "iface %p, name %p.\n", iface, name );
+    if (!name) return E_POINTER;
+    return WindowsCreateString( L"Windows.UI.UIContext", 20, name );
+}
+
+static HRESULT WINAPI context_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
