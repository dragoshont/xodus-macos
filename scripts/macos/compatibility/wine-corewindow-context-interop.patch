+HRESULT WINAPI CreateCoreWindow( DWORD type, const WCHAR *title, INT x, INT y, UINT width,
+                                UINT height, DWORD attributes, HWND owner, REFIID iid, void **out )
+{
+    struct corewindow *impl;
+    HRESULT hr;
+
+    TRACE( "type %lu, title %s, x %d, y %d, width %u, height %u, attributes %#lx, "
+           "owner %p, iid %s, out %p.\n", type, debugstr_w(title), x, y, width, height,
+           attributes, owner, debugstr_guid(iid), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!iid) return E_INVALIDARG;
+    FIXME( "type %lu and attributes %#lx are not interpreted by the HWND backend.\n", type, attributes );
+    EnterCriticalSection( &windows_cs );
+    LIST_FOR_EACH_ENTRY( impl, &windows, struct corewindow, entry )
+    {
+        if (impl->thread_id == GetCurrentThreadId())
+        {
+            LeaveCriticalSection( &windows_cs );
+            WARN( "thread %lx already owns a CoreWindow.\n", GetCurrentThreadId() );
+            return E_ILLEGAL_METHOD_CALL;
+        }
+    }
+    LeaveCriticalSection( &windows_cs );
+    if (FAILED(hr = corewindow_create( title, x, y, width, height, owner, &impl ))) return hr;
+    hr = ICoreWindow_QueryInterface( &impl->ICoreWindow_iface, iid, out );
+    if (FAILED(hr))
+    {
+        WARN( "requested interface %s unavailable, hr %#lx; destroying new window.\n", debugstr_guid(iid), hr );
+        DestroyWindow( impl->hwnd );
+    }
+    else impl->published = TRUE;
+    return hr;
 }
 
