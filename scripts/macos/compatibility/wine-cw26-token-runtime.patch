+    if (!(token = get_token_obj( current->process, req->handle, TOKEN_QUERY ))) return;
+    data = tsa_store_data( &token->security_attributes, &bytes );
+    reply->attributes_len = bytes;
+    if (get_reply_max_size() < bytes) set_error( STATUS_BUFFER_TOO_SMALL );
+    else set_reply_data( data, bytes );
+    release_object( token );
+}
