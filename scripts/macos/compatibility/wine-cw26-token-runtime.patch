+/* Internal provisioning seam only; no client request or public setter grants
+ * permission to create package identities. Callers must have genuine data. */
+int token_replace_security_attributes( struct token *token, const void *data, unsigned int bytes )
+{
+    unsigned int status = tsa_store_replace( &token->security_attributes, data, bytes );
+    if (status)
+    {
+        set_error( status );
+        return 0;
+    }
+    allocate_luid( &token->modified_id );
+    return 1;
+}
