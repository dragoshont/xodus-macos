+/* Exported by wintypes.dll (api-ms-win-core-winrt-propertysetprivate-l1-1-0), no SDK
+ * prototype.  ABI grounded by the genuine twinapi.appcore.dll call sites 0x1800172de
+ * and 0x18001732c: one argument, the address of a ComPtr field of the
+ * CoreApplicationView (the backing store for ICoreApplicationView::get_Properties,
+ * which is typed IPropertySet ** in the public metadata); a failure HRESULT aborts view
+ * initialisation.  Suppress the inner map's IAgileObject marker only for instances
+ * created by this export; regular PropertySet activation retains its behavior. */
+HRESULT WINAPI RoCreateNonAgilePropertySet( IPropertySet **out )
+{
+    IInspectable *inspectable;
+    HRESULT hr;
+
+    TRACE( "out %p\n", out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (FAILED(hr = propertyset_create( TRUE, &inspectable ))) return hr;
+    hr = IInspectable_QueryInterface( inspectable, &IID_IPropertySet, (void **)out );
+    IInspectable_Release( inspectable );
+    return hr;
+}
