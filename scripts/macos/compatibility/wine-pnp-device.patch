+static void test_DevGetObjects_device( void )
+{
+    DEVPROPCOMPKEY keys[] = {{DEVPKEY_Device_ClassGuid, DEVPROP_STORE_SYSTEM},
+                            {DEVPKEY_dummy, DEVPROP_STORE_SYSTEM}};
+    const DEV_OBJECT *objects = NULL;
+    ULONG count = 0, i;
+    HRESULT hr;
+
+    if (!pDevGetObjects || !pDevFreeObjects) return;
+    hr = pDevGetObjects( DevObjectTypeDevice, 0, ARRAY_SIZE(keys), keys, 0, NULL, &count, &objects );
+    ok( hr == S_OK, "Device enumeration returned %#lx\n", hr );
+    if (FAILED(hr)) return;
+    ok( count > 0, "No real devnodes returned\n" );
+    for (i = 0; i < count; i++)
+    {
+        const DEV_OBJECT *object = &objects[i];
+        GUID guid;
+        DEVPROPTYPE type;
+        DEVINST node;
+        ULONG size = sizeof(guid);
+        CONFIGRET cr;
+
+        ok( object->ObjectType == DevObjectTypeDevice, "Wrong type %d\n", object->ObjectType );
+        ok( object->cPropertyCount == ARRAY_SIZE(keys), "Wrong count %lu\n", object->cPropertyCount );
+        cr = CM_Locate_DevNodeW( &node, (WCHAR *)object->pszObjectId, 0 );
+        ok( cr == CR_SUCCESS, "Cannot locate returned node: %lu\n", cr );
+        if (cr != CR_SUCCESS || object->cPropertyCount != ARRAY_SIZE(keys)) continue;
+        cr = CM_Get_DevNode_PropertyW( node, &keys[0].Key, &type, &guid, &size, 0 );
+        if (cr == CR_NO_SUCH_VALUE)
+            ok( object->pProperties[0].Type == DEVPROP_TYPE_EMPTY, "Missing GUID not EMPTY\n" );
+        else
+        {
+            ok( cr == CR_SUCCESS && type == DEVPROP_TYPE_GUID, "GUID query failed %lu/%lu\n", cr, type );
+            if (cr == CR_SUCCESS)
+            {
+                ok( object->pProperties[0].Type == DEVPROP_TYPE_GUID, "GUID was not typed\n" );
+                ok( object->pProperties[0].BufferSize == sizeof(guid), "GUID size differs\n" );
+                if (object->pProperties[0].BufferSize == sizeof(guid))
+                    ok( IsEqualGUID( &guid, object->pProperties[0].Buffer ), "GUID differs from CM\n" );
+            }
+        }
+        ok( object->pProperties[1].Type == DEVPROP_TYPE_EMPTY && !object->pProperties[1].BufferSize &&
+            !object->pProperties[1].Buffer, "Missing property fabricated\n" );
+    }
+    pDevFreeObjects( count, objects );
+
+    hr = pDevGetObjects( DevObjectTypeDevice, DevQueryFlagAllProperties, 0, NULL, 0, NULL, &count, &objects );
+    ok( hr == E_NOTIMPL && !objects && !count, "Unsupported all-properties returned %#lx\n", hr );
+    keys[0].Store = DEVPROP_STORE_USER;
+    hr = pDevGetObjects( DevObjectTypeDevice, 0, 1, keys, 0, NULL, &count, &objects );
+    ok( hr == E_NOTIMPL && !objects && !count, "Unsupported store returned %#lx\n", hr );
+    hr = pDevGetObjects( DevObjectTypeDevice, 0, 1, NULL, 0, NULL, &count, &objects );
+    ok( hr == E_INVALIDARG, "Invalid property array accepted: %#lx\n", hr );
+}
