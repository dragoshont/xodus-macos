+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct pnp_factory *impl = impl_from_factory( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory )) *out = iface;
+    else if (IsEqualGUID( iid, &IID_IPnpObjectStatics )) *out = &impl->IPnpObjectStatics_iface;
+    else return E_NOINTERFACE;
+    IActivationFactory_AddRef( iface );
+    return S_OK;
+}
