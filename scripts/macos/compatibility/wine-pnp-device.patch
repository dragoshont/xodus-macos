+static HRESULT dev_object_node_get_props( DEV_OBJECT *obj, DEVINST node, ULONG count, const DEVPROPCOMPKEY *keys )
+{
+    ULONG i;
+    HRESULT hr = S_OK;
+
+    for (i = 0; i < count; i++)
+    {
+        DEVPROPTYPE type;
+        ULONG size = 0, attempt;
+        CONFIGRET ret;
+        BYTE *buffer = NULL;
+
+        if (keys[i].Store != DEVPROP_STORE_SYSTEM || (keys[i].LocaleName && *keys[i].LocaleName))
+        {
+            FIXME( "Unsupported property store or locale.\n" );
+            hr = E_NOTIMPL;
+            break;
+        }
+        ret = CM_Get_DevNode_PropertyW( node, &keys[i].Key, &type, NULL, &size, 0 );
+        if (ret == CR_NO_SUCH_VALUE)
+            type = DEVPROP_TYPE_EMPTY;
+        else if (ret != CR_BUFFER_SMALL && ret != CR_SUCCESS)
+        {
+            hr = HRESULT_FROM_WIN32( CM_MapCrToWin32Err( ret, ERROR_GEN_FAILURE ) );
+            break;
+        }
+        else if (size)
+        {
+            for (attempt = 0; attempt < 3; attempt++)
+            {
+                BYTE *tmp;
+                if (!size)
+                {
+                    free( buffer );
+                    buffer = NULL;
+                    hr = E_UNEXPECTED;
+                    break;
+                }
+                if (!(tmp = realloc( buffer, size )))
+                {
+                    free( buffer );
+                    buffer = NULL;
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                buffer = tmp;
+                ret = CM_Get_DevNode_PropertyW( node, &keys[i].Key, &type, buffer, &size, 0 );
+                if (ret != CR_BUFFER_SMALL) break;
+            }
+            if (FAILED(hr)) break;
+            if (ret == CR_NO_SUCH_VALUE)
+            {
+                free( buffer );
+                buffer = NULL;
+                type = DEVPROP_TYPE_EMPTY;
+                ret = CR_SUCCESS;
+            }
+            if (ret != CR_SUCCESS)
+            {
+                free( buffer );
+                hr = HRESULT_FROM_WIN32( CM_MapCrToWin32Err( ret, ERROR_GEN_FAILURE ) );
+                break;
+            }
+        }
+        if (!dev_properties_append( (DEVPROPERTY **)&obj->pProperties, &obj->cPropertyCount,
+                                   &keys[i].Key, type, buffer ? size : 0, buffer ))
+        {
+            free( buffer );
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+    }
+    if (FAILED(hr))
+    {
+        DevFreeObjectProperties( obj->cPropertyCount, obj->pProperties );
+        obj->pProperties = NULL;
+        obj->cPropertyCount = 0;
+    }
+    return hr;
+}
