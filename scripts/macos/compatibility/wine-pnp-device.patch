+static HRESULT WINAPI object_QueryInterface( IPnpObject *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IAgileObject ) && !IsEqualGUID( iid, &IID_IPnpObject ))
+        return E_NOINTERFACE;
+    IPnpObject_AddRef( iface );
+    *out = iface;
+    return S_OK;
+}
+
+static ULONG WINAPI object_AddRef( IPnpObject *iface )
+{
+    return InterlockedIncrement( &impl_from_IPnpObject( iface )->ref );
+}
+
+static ULONG WINAPI object_Release( IPnpObject *iface )
+{
+    struct pnp_object *impl = impl_from_IPnpObject( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->id );
+        IMap_HSTRING_IInspectable_Release( impl->properties );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI object_GetIids( IPnpObject *iface, ULONG *count, IID **iids )
+{
