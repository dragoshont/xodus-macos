+struct pnp_request
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    ULONG count;
+    DEVPROPCOMPKEY *keys;
+    HSTRING *names;
+};
+
+static struct pnp_request *impl_from_request( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct pnp_request, IUnknown_iface );
+}
+
+static HRESULT WINAPI request_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IAgileObject ))
+        return E_NOINTERFACE;
+    IUnknown_AddRef( iface );
+    *out = iface;
+    return S_OK;
+}
+
+static ULONG WINAPI request_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &impl_from_request( iface )->ref );
+}
+
+static ULONG WINAPI request_Release( IUnknown *iface )
+{
+    struct pnp_request *impl = impl_from_request( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref ), i;
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) WindowsDeleteString( impl->names[i] );
+        free( impl->keys );
+        free( impl->names );
+        free( impl );
+    }
+    return ref;
+}
+
+static const IUnknownVtbl request_vtbl =
+{
+    request_QueryInterface, request_AddRef, request_Release,
+};
+
+static HRESULT request_create( IIterable_HSTRING *properties, struct pnp_request **out )
+{
+    IIterator_HSTRING *iterator;
+    struct pnp_request *impl;
+    boolean current;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IUnknown_iface.lpVtbl = &request_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = IIterable_HSTRING_First( properties, &iterator ))) goto failed;
+    for (hr = IIterator_HSTRING_get_HasCurrent( iterator, &current ); SUCCEEDED(hr) && current;
+         hr = IIterator_HSTRING_MoveNext( iterator, &current ))
+    {
+        DEVPROPCOMPKEY key = {0}, *keys;
+        HSTRING name, *names;
+        const WCHAR *text;
+
+        if (FAILED(hr = IIterator_HSTRING_get_Current( iterator, &name ))) break;
+        text = WindowsGetStringRawBuffer( name, NULL );
+        hr = text[0] == '{' ? PSPropertyKeyFromString( text, (PROPERTYKEY *)&key.Key ) :
+                             PSGetPropertyKeyFromName( text, (PROPERTYKEY *)&key.Key );
+        if (SUCCEEDED(hr))
+        {
+            if (!(keys = realloc( impl->keys, (impl->count + 1) * sizeof(*keys) ))) hr = E_OUTOFMEMORY;
+            else
+            {
+                impl->keys = keys;
+                if (!(names = realloc( impl->names, (impl->count + 1) * sizeof(*names) ))) hr = E_OUTOFMEMORY;
+                else
+                {
+                    impl->names = names;
+                    impl->keys[impl->count] = key;
+                    hr = WindowsDuplicateString( name, &impl->names[impl->count] );
+                    if (SUCCEEDED(hr)) impl->count++;
+                }
+            }
+        }
+        WindowsDeleteString( name );
+        if (FAILED(hr)) break;
+    }
+    IIterator_HSTRING_Release( iterator );
+    if (FAILED(hr)) goto failed;
+    *out = impl;
+    return S_OK;
+failed:
+    IUnknown_Release( &impl->IUnknown_iface );
+    return hr;
+}
+
+static HRESULT find_all_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    static const struct vector_iids iids =
+    {
+        &IID_IVector_IInspectable, &IID_IVectorView_PnpObject,
+        &IID_IIterable_PnpObject, &IID_IIterator_PnpObject,
+    };
+    struct pnp_request *request = impl_from_request( param );
+    const DEV_OBJECT *objects;
+    IVector_IInspectable *vector;
+    ULONG count, i;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    hr = DevGetObjects( DevObjectTypeDevice, DevQueryFlagNone, request->count,
+                        request->keys, 0, NULL, &count, &objects );
+    if (FAILED(hr)) return hr;
+    if (SUCCEEDED(hr = vector_create( &iids, (void **)&vector )))
+    {
+        for (i = 0; i < count && SUCCEEDED(hr); i++)
+        {
+            struct pnp_object *impl;
+            if (!(impl = calloc( 1, sizeof(*impl) ))) { hr = E_OUTOFMEMORY; break; }
+            impl->IPnpObject_iface.lpVtbl = &object_vtbl;
+            impl->ref = 1;
+            /* The Device backend returns requested properties in order, including EMPTY entries. */
+            if (objects[i].cPropertyCount != request->count) hr = E_UNEXPECTED;
+            else hr = create_device_properties( objects[i].pProperties, request->count, request->names, &impl->properties );
+            if (SUCCEEDED(hr))
+                hr = WindowsCreateString( objects[i].pszObjectId, wcslen( objects[i].pszObjectId ), &impl->id );
+            if (FAILED(hr))
+            {
+                if (impl->properties) IMap_HSTRING_IInspectable_Release( impl->properties );
+                free( impl );
+                break;
+            }
+            hr = IVector_IInspectable_Append( vector, (IInspectable *)&impl->IPnpObject_iface );
+            IPnpObject_Release( &impl->IPnpObject_iface );
+        }
+        if (SUCCEEDED(hr))
+        {
+            hr = IVector_IInspectable_GetView( vector, (IVectorView_IInspectable **)&result->punkVal );
+            if (SUCCEEDED(hr)) result->vt = VT_UNKNOWN;
+        }
+        IVector_IInspectable_Release( vector );
+    }
+    DevFreeObjects( count, objects );
+    return hr;
+}
+
+struct pnp_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IPnpObjectStatics IPnpObjectStatics_iface;
+    LONG ref;
+};
