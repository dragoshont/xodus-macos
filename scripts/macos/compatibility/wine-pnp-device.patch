+static HRESULT enum_dev_nodes( ULONG props_len, const DEVPROPCOMPKEY *props,
+                               enum_device_object_cb callback, void *data )
+{
+    WCHAR *ids = NULL, *id;
+    ULONG len, attempt;
+    CONFIGRET ret;
+    HRESULT hr = S_OK;
+
+    for (attempt = 0; attempt < 3; attempt++)
+    {
+        ret = CM_Get_Device_ID_List_SizeW( &len, NULL, CM_GETIDLIST_FILTER_NONE );
+        if (ret != CR_SUCCESS) break;
+        free( ids );
+        if (!(ids = calloc( len, sizeof(*ids) ))) return E_OUTOFMEMORY;
+        ret = CM_Get_Device_ID_ListW( NULL, ids, len, CM_GETIDLIST_FILTER_NONE );
+        if (ret != CR_BUFFER_SMALL) break;
+    }
+    if (ret != CR_SUCCESS)
+    {
+        free( ids );
+        return HRESULT_FROM_WIN32( CM_MapCrToWin32Err( ret, ERROR_GEN_FAILURE ) );
+    }
+    for (id = ids; *id && SUCCEEDED(hr); id += wcslen( id ) + 1)
+    {
+        DEV_OBJECT obj = {.ObjectType = DevObjectTypeDevice, .pszObjectId = id};
+        DEVINST node;
+
+        ret = CM_Locate_DevNodeW( &node, id, 0 );
+        if (ret != CR_SUCCESS)
+        {
+            hr = HRESULT_FROM_WIN32( CM_MapCrToWin32Err( ret, ERROR_GEN_FAILURE ) );
+            break;
+        }
+        if (FAILED(hr = dev_object_node_get_props( &obj, node, props_len, props ))) break;
+        hr = callback( obj, data );
+        if (FAILED(hr)) DevFreeObjectProperties( obj.cPropertyCount, obj.pProperties );
+    }
+    free( ids );
+    return hr;
+}
