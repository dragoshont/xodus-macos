+    hr = IPnpObjectStatics_CreateWatcherAqsFilter(statics, PnpObjectType_Device, properties, NULL, &watcher);
+    ok( hr == E_NOTIMPL && !watcher, "AQS watcher must fail %#lx\n", hr );
+    ok( IPnpObjectStatics_FindAllAsync(statics, PnpObjectType_Device, NULL, &operation) == E_INVALIDARG && !operation,
