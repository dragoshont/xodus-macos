+struct pnp_completed
+{
+    IAsyncOperationCompletedHandler_PnpObjectCollection iface;
+    LONG ref, calls;
+    HANDLE event;
+    AsyncStatus status;
+    IAsyncOperation_PnpObjectCollection *operation;
+};
+
+static HRESULT WINAPI pnp_completed_QI( IAsyncOperationCompletedHandler_PnpObjectCollection *iface,
+                                        REFIID iid, void **out )
+{
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IAgileObject ) &&
+        !IsEqualGUID( iid, &IID_IAsyncOperationCompletedHandler_PnpObjectCollection )) return E_NOINTERFACE;
+    IAsyncOperationCompletedHandler_PnpObjectCollection_AddRef( iface );
+    *out = iface;
+    return S_OK;
+}
+static ULONG WINAPI pnp_completed_AddRef( IAsyncOperationCompletedHandler_PnpObjectCollection *iface )
+{
+    return InterlockedIncrement( &CONTAINING_RECORD(iface, struct pnp_completed, iface)->ref );
+}
+static ULONG WINAPI pnp_completed_Release( IAsyncOperationCompletedHandler_PnpObjectCollection *iface )
+{
+    struct pnp_completed *handler = CONTAINING_RECORD(iface, struct pnp_completed, iface);
+    ULONG ref = InterlockedDecrement( &handler->ref );
+    if (!ref) free(handler);
+    return ref;
+}
+static HRESULT WINAPI pnp_completed_Invoke( IAsyncOperationCompletedHandler_PnpObjectCollection *iface,
+                                            IAsyncOperation_PnpObjectCollection *operation, AsyncStatus status )
+{
+    struct pnp_completed *handler = CONTAINING_RECORD(iface, struct pnp_completed, iface);
+    handler->operation = operation;
+    handler->status = status;
+    InterlockedIncrement( &handler->calls );
+    SetEvent( handler->event );
+    return S_OK;
+}
+static const IAsyncOperationCompletedHandler_PnpObjectCollectionVtbl pnp_completed_vtbl =
+{
+    pnp_completed_QI, pnp_completed_AddRef, pnp_completed_Release, pnp_completed_Invoke,
+};
+
+static HRESULT pnp_await( IAsyncOperation_PnpObjectCollection *operation, AsyncStatus expected,
+                          IVectorView_PnpObject **view )
+{
+    struct pnp_completed *handler = calloc(1, sizeof(*handler));
+    IAsyncInfo *info = NULL;
+    AsyncStatus status;
+    HRESULT hr, error = E_UNEXPECTED;
+    DWORD i, wait;
+
+    if (!handler) return E_OUTOFMEMORY;
+    handler->iface.lpVtbl = &pnp_completed_vtbl;
+    handler->ref = 1;
+    handler->event = CreateEventW( NULL, FALSE, FALSE, NULL );
+    hr = IAsyncOperation_PnpObjectCollection_put_Completed( operation, &handler->iface );
+    ok( hr == S_OK, "put_Completed %#lx\n", hr );
+    wait = WaitForSingleObject( handler->event, 5000 );
+    ok( wait == WAIT_OBJECT_0, "Completion timed out %lu\n", wait );
+    /* Invoke signals before the worker releases its delegate reference. */
+    for (i = 0; i < 500 && InterlockedCompareExchange( &handler->ref, 1, 1 ) != 1; i++) Sleep(10);
+    ok( handler->ref == 1 && handler->calls == 1, "Delegate refs/calls %ld/%ld\n", handler->ref, handler->calls );
+    ok( handler->operation == operation && handler->status == expected, "Wrong completion identity/status\n" );
+    hr = IAsyncOperation_PnpObjectCollection_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info );
+    ok( hr == S_OK, "AsyncInfo QI %#lx\n", hr );
+    if (info)
+    {
+        hr = IAsyncInfo_get_Status( info, &status );
+        ok( hr == S_OK && status == expected, "Async status %#lx/%d\n", hr, status );
+        hr = IAsyncInfo_get_ErrorCode( info, &error );
+        ok( hr == S_OK, "ErrorCode %#lx\n", hr );
+    }
+    hr = IAsyncOperation_PnpObjectCollection_GetResults( operation, view );
+    ok( hr == error, "GetResults %#lx differs from backend error %#lx\n", hr, error );
+    if (info)
+    {
+        ok( IAsyncInfo_Close( info ) == S_OK, "Async Close failed\n" );
+        IAsyncInfo_Release( info );
+    }
+    IAsyncOperation_PnpObjectCollection_Release( operation );
+    CloseHandle( handler->event );
+    ok( pnp_completed_Release(&handler->iface) == 0, "Completion handler leaked\n" );
+    return hr;
+}
