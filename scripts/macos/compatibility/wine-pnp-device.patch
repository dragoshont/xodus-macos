+            ok( IPnpObject_get_Properties(object, &map) == S_OK, "Properties failed\n" );
+            if (map)
+            {
+                WindowsCreateString(names[0], wcslen(names[0]), &key);
+                hr = IMapView_HSTRING_IInspectable_Lookup(map, key, &boxed);
+                ok( hr == S_OK && !!boxed, "Caller GUID key lost %#lx\n", hr );
+                WindowsDeleteString(key);
+                if (boxed)
+                {
+                    hr = IInspectable_QueryInterface(boxed, &IID_IPropertyValue, (void **)&value);
+                    ok( hr == S_OK, "GUID box QI %#lx\n", hr );
+                    if (value)
+                    {
+                        hr = IPropertyValue_GetGuid(value, &guid);
+                        ok( hr == S_OK && IsEqualGUID(&guid, &fixture_guid), "Boxed GUID differs %#lx\n", hr );
+                        IPropertyValue_Release(value);
+                    }
+                    IInspectable_Release(boxed);
+                }
+                WindowsCreateString(names[1], wcslen(names[1]), &key);
+                boxed = (void *)0xdeadbeef;
+                hr = IMapView_HSTRING_IInspectable_Lookup(map, key, &boxed);
+                ok( hr == S_OK && !boxed, "Missing DriverVersion must project null %#lx/%p\n", hr, boxed );
+                WindowsDeleteString(key);
+                IMapView_HSTRING_IInspectable_Release(map);
+            }
+        }
+        WindowsDeleteString(id);
+        IPnpObject_Release(object);
+    }
+    ok( found, "Registered devnode omitted\n" );
+    for (i = 0; i < 500; i++)
+    {
+        ULONG ref;
+        IVectorView_PnpObject_AddRef(view);
+        ref = IVectorView_PnpObject_Release(view);
+        if (ref == 1) break;
+        Sleep(10);
+    }
+    ok( IVectorView_PnpObject_Release(view) == 0, "Collection leaked\n" );
+    view = NULL;
+
+    properties = iterable_hstring_create(names, ARRAY_SIZE(names));
+    operation = (void *)0xdeadbeef;
+    hr = IPnpObjectStatics_FindAllAsync(statics, PnpObjectType_DeviceInterface, properties, &operation);
+    ok( hr == E_NOTIMPL && !operation, "Unsupported kind %#lx\n", hr );
