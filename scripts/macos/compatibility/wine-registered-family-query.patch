diff --git a/server/protocol.def b/server/protocol.def
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1,4 +1,12 @@
 @REQ(set_token_integrity)
     obj_handle_t handle;
     unsigned int level;
 @END
+
+/* Read-only inventory of the explicit prefix-local main registration. */
+@REQ(query_registered_family)
+    VARARG(family,unicode_str);
+@REPLY
+    data_size_t full_name_bytes;
+    VARARG(full_name,unicode_str);
+@END
