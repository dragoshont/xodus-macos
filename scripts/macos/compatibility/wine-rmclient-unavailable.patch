+#include <stdarg.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rmclient);
+
+HRESULT WINAPI HamConnectForExtendedExecution(const void *descriptor, HANDLE *connection)
+{
+    ERR("(%p, %p): HAM backend unavailable; extended execution is not granted.\n", descriptor, connection);
+    if (!connection) return E_POINTER;
+    *connection = NULL;
+    return HRESULT_FROM_WIN32(RPC_S_SERVER_UNAVAILABLE);
+}
