+
+void WINAPI RoRevokeActivationFactories(RO_REGISTRATION_COOKIE cookie)
+{
+    struct activation_registration *registration, *found = NULL;
+
+    TRACE("cookie %p.\n", cookie);
+    if (!cookie) return;
+    AcquireSRWLockExclusive(&activation_registration_lock);
+    LIST_FOR_EACH_ENTRY(registration, &activation_registrations, struct activation_registration, entry)
+        if (registration->cookie == cookie)
+        {
+            list_remove(&registration->entry);
+            found = registration;
+            break;
+        }
+    ReleaseSRWLockExclusive(&activation_registration_lock);
+    if (found) release_activation_registration(found);
+    else WARN("Unknown or revoked activation registration cookie %p.\n", cookie);
+}
