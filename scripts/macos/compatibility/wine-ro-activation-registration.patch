+static void trace_illegal_method_call(HRESULT error)
+{
+    void *frames[8];
+    HMODULE base;
+    USHORT count, i;
+
+    if (error != E_ILLEGAL_METHOD_CALL) return;
+    count = RtlCaptureStackBackTrace(0, ARRAY_SIZE(frames), frames, NULL);
+    for (i = 0; i < count; ++i)
+    {
+        base = NULL;
+        GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          (const WCHAR *)frames[i], &base);
+        FIXME("Illegal-method-call origin frame %u: ip %p, module %p, offset %#Ix.\n",
+              i, frames[i], base, base ? (ULONG_PTR)frames[i] - (ULONG_PTR)base : 0);
+    }
+}
