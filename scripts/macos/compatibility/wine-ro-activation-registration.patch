+BOOL WINAPI IsErrorPropagationEnabled(void)
+{
+    TRACE("Error propagation is disabled.\n");
+    return FALSE;
+}
+
+BOOL WINAPI RoTransformError(HRESULT old_error, HRESULT new_error, HSTRING message)
+{
+    trace_illegal_method_call(new_error);
+    TRACE("old %#lx, new %#lx, message %s; no error transformation.\n",
+          old_error, new_error, debugstr_hstring(message));
+    return FALSE;
+}
+
+BOOL WINAPI RoTransformErrorW(HRESULT old_error, HRESULT new_error, UINT max_len, const WCHAR *message)
+{
+    trace_illegal_method_call(new_error);
+    TRACE("old %#lx, new %#lx, max_len %u, message %p; no error transformation.\n",
+          old_error, new_error, max_len, message);
+    return FALSE;
+}
