+struct registered_activation_class
+{
+    HSTRING name;
+    PFNGETACTIVATIONFACTORY callback;
+};
+
+struct activation_registration
+{
+    struct list entry;
+    RO_REGISTRATION_COOKIE cookie;
+    LONG ref;
+    UINT32 count;
+    struct registered_activation_class classes[];
+};
+
+static SRWLOCK activation_registration_lock = SRWLOCK_INIT;
+static struct list activation_registrations = LIST_INIT(activation_registrations);
+static ULONG_PTR activation_cookie;
+
+static BOOL activation_names_equal(HSTRING first, HSTRING second)
+{
+    INT order;
+    return SUCCEEDED(WindowsCompareStringOrdinal(first, second, &order)) && !order;
+}
+
+static void release_activation_registration(struct activation_registration *registration)
+{
+    UINT32 i;
+
+    if (InterlockedDecrement(&registration->ref)) return;
+    for (i = 0; i < registration->count; ++i) WindowsDeleteString(registration->classes[i].name);
+    free(registration);
+}
+
+static BOOL get_registered_activation_factory(HSTRING name, REFIID iid, void **out, HRESULT *result)
+{
+    struct activation_registration *registration, *found = NULL;
+    IActivationFactory *factory = NULL;
+    UINT32 i, index = 0;
+
+    AcquireSRWLockShared(&activation_registration_lock);
+    LIST_FOR_EACH_ENTRY(registration, &activation_registrations, struct activation_registration, entry)
+    {
+        for (i = 0; i < registration->count; ++i)
+            if (activation_names_equal(name, registration->classes[i].name))
+            {
+                found = registration;
+                index = i;
+                InterlockedIncrement(&found->ref);
+                break;
+            }
+        if (found) break;
+    }
+    ReleaseSRWLockShared(&activation_registration_lock);
+    if (!found) return FALSE;
+
+    /* Callbacks can reenter activation or revoke their own registration. */
+    TRACE("registered class %s, cookie %p, callback %p.\n",
+          debugstr_hstring(found->classes[index].name), found->cookie, found->classes[index].callback);
+    *result = found->classes[index].callback(found->classes[index].name, &factory);
+    if (SUCCEEDED(*result))
+    {
+        if (factory) *result = IActivationFactory_QueryInterface(factory, iid, out);
+        else
+        {
+            ERR("Registered callback returned success without a factory for %s.\n", debugstr_hstring(name));
+            *result = E_UNEXPECTED;
+        }
+    }
+    else ERR("Registered callback for %s failed, hr %#lx.\n", debugstr_hstring(name), *result);
+    if (factory) IActivationFactory_Release(factory);
+    release_activation_registration(found);
+    return TRUE;
+}
