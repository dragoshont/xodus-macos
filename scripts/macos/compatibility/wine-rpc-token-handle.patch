+RPC_STATUS RPCRT4_GetLocalPeerProcessId(PRPC_MESSAGE message, ULONG *pid)
+{
+    RpcBinding *binding;
+    RpcConnection *connection;
+    RpcConnection_np *pipe;
+
+    if (!message || !(binding = message->Handle) || !pid)
+        return RPC_S_INVALID_BINDING;
+    connection = binding->server ? binding->FromConn : message->ReservedForRuntime;
+    if (!connection || strcmp(connection->ops->name, "ncalrpc"))
+        return RPC_S_PROTSEQ_NOT_SUPPORTED;
+    pipe = (RpcConnection_np *)connection;
+    if (connection->server)
+        return GetNamedPipeClientProcessId(pipe->pipe, pid) ? RPC_S_OK : RPC_S_INVALID_BINDING;
+    return GetNamedPipeServerProcessId(pipe->pipe, pid) ? RPC_S_OK : RPC_S_INVALID_BINDING;
 }
 
