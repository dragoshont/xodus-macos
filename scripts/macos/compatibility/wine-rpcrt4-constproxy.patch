+struct factory_tables
+{
+    struct factory_tables *next;
+    IPSFactoryBuffer *factory;
+    const ProxyFileInfo *file;
+    int index;
+    CInterfaceProxyVtbl *proxy;
+    CInterfaceStubVtbl stub;
+    PRPC_STUB_FUNCTION *dispatch;
+};
+
+static SRWLOCK tables_lock = SRWLOCK_INIT;
+static struct factory_tables *tables;
+
+LONG WINAPI NdrStubCall3(IRpcStubBuffer *, IRpcChannelBuffer *, PRPC_MESSAGE, DWORD *);
+
+static ULONG WINAPI compact_stub_release(IRpcStubBuffer *stub)
+{
+    return NdrCStdStubBuffer_Release(stub, ((CStdStubBuffer *)stub)->pPSFactory);
+}
+
+static ULONG WINAPI compact_delegating_stub_release(IRpcStubBuffer *stub)
+{
+    return NdrCStdStubBuffer2_Release(stub, ((CStdStubBuffer *)stub)->pPSFactory);
+}
+
+static void WINAPI compact_stub_call(IRpcStubBuffer *stub, IRpcChannelBuffer *channel,
+                                     PRPC_MESSAGE msg, DWORD *phase)
+{
+    const MIDL_SERVER_INFO *info = CStdStubBuffer_GetServerInfo(stub);
+    if (info->nCount && info->pSyntaxInfo) NdrStubCall3(stub, channel, msg, phase);
+    else NdrStubCall2(stub, channel, msg, phase);
+}
+
+/* DLL-supplied metadata can be read-only. Copies live until process exit,
+ * independently of factory reference counts and outstanding proxies. */
+HRESULT get_psfactory_tables(IPSFactoryBuffer *factory, const ProxyFileInfo *file, int index,
+                             CInterfaceProxyVtbl **proxy, CInterfaceStubVtbl **stub)
+{
+    struct factory_tables *entry;
+    const IRpcStubBufferVtbl *defaults = &CStdStubBuffer_Vtbl;
+    DWORD count = file->pStubVtblList[index]->header.DispatchTableCount, i;
+    SIZE_T prefix = file->TableVersion > 1 ? sizeof(void *) : 0;
+    SIZE_T size = prefix + offsetof(CInterfaceProxyVtbl, Vtbl) + count * sizeof(void *);
+    const CInterfaceProxyVtbl *source_proxy =
+        (const CInterfaceProxyVtbl *)((const char *)file->pProxyVtblList[index] + prefix);
+    const CInterfaceStubVtbl *source_stub = file->pStubVtblList[index];
+    const MIDL_STUBLESS_PROXY_INFO *info =
+        prefix ? *(const MIDL_STUBLESS_PROXY_INFO **)file->pProxyVtblList[index] : NULL;
+    BOOL compact_proxy = source_proxy->Vtbl[0] == (void *)-1;
+    BOOL compact_stub = source_stub->Vtbl.QueryInterface == (void *)-2 ||
+        (compact_proxy && !source_stub->Vtbl.QueryInterface);
+    void **methods, *allocation;
+    BOOL delegated = file->pDelegatedIIDs && file->pDelegatedIIDs[index];
+    HRESULT hr = S_OK;
+
+    if (count < 3 || count >= NB_THUNK_ENTRIES)
+    {
+        FIXME("Unsupported proxy method count %lu.\n", count);
+        return E_NOTIMPL;
+    }
+    if (compact_proxy && (!info || !info->FormatStringOffset))
+    {
+        WARN("Compact proxy is missing stubless metadata.\n");
+        return E_INVALIDARG;
+    }
+    AcquireSRWLockExclusive(&tables_lock);
+    for (entry = tables; entry; entry = entry->next)
+        if (entry->factory == factory && entry->file == file && entry->index == index)
+            goto found;
+    entry = calloc(1, sizeof(*entry));
+    allocation = calloc(1, size);
+    if (!entry || !allocation)
+    {
+        free(entry);
+        free(allocation);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    memcpy(allocation, file->pProxyVtblList[index],
+           compact_proxy ? prefix + offsetof(CInterfaceProxyVtbl, Vtbl) : size);
+    entry->proxy = (CInterfaceProxyVtbl *)((char *)allocation + prefix);
+    entry->stub.header = source_stub->header;
+    if (delegated) defaults = &CStdStubBuffer_Delegating_Vtbl;
+    if (compact_proxy)
+    {
+        entry->proxy->Vtbl[0] = IUnknown_QueryInterface_Proxy;
+        entry->proxy->Vtbl[1] = IUnknown_AddRef_Proxy;
+        entry->proxy->Vtbl[2] = IUnknown_Release_Proxy;
+        for (i = 3; i < count; i++)
+        {
+            if (info->FormatStringOffset[i] == 0xffff)
+            {
+                if (!delegated)
+                {
+                    WARN("Compact method %lu requires a delegated base interface.\n", i);
+                    hr = E_NOTIMPL;
+                    goto failed;
+                }
+            }
+            else entry->proxy->Vtbl[i] = (void *)-1;
+        }
+    }
+    if (compact_stub)
+    {
+        entry->stub.Vtbl = *defaults;
+        entry->stub.Vtbl.Release = delegated ? compact_delegating_stub_release : compact_stub_release;
+    }
+    else entry->stub.Vtbl = source_stub->Vtbl;
+    if (source_stub->header.pDispatchTable == (const PRPC_STUB_FUNCTION *)-2)
+    {
+        if (!info || !info->FormatStringOffset)
+        {
+            WARN("Compact dispatch table is missing procedure offsets.\n");
+            hr = E_INVALIDARG;
+            goto failed;
+        }
+        entry->dispatch = calloc(count, sizeof(*entry->dispatch));
+        if (!entry->dispatch)
+        {
+            hr = E_OUTOFMEMORY;
+            goto failed;
+        }
+        for (i = 3; i < count; i++)
+            entry->dispatch[i] = info->FormatStringOffset[i] == 0xffff ?
+                NdrStubForwardingFunction : compact_stub_call;
+        entry->stub.header.pDispatchTable = entry->dispatch;
+    }
+    if (delegated)
+    {
+        fill_delegated_proxy_table((IUnknownVtbl *)entry->proxy->Vtbl, count);
+    }
+    if (prefix) fill_stubless_table((IUnknownVtbl *)entry->proxy->Vtbl, count);
+    methods = (void **)&entry->stub.Vtbl;
+    for (i = 0; i < sizeof(*defaults) / sizeof(void *); i++)
+        if (!methods[i]) methods[i] = ((void * const *)defaults)[i];
+    entry->factory = factory;
+    entry->file = file;
+    entry->index = index;
+    entry->next = tables;
+    tables = entry;
+    TRACE("Copied proxy file %p index %d: %lu slots, compact proxy %u stub %u dispatch %u.\n",
+          file, index, count, compact_proxy, compact_stub, !!entry->dispatch);
+    goto found;
+failed:
+    free(entry->dispatch);
+    free(allocation);
+    free(entry);
+    goto done;
+found:
+    if (proxy) *proxy = entry->proxy;
+    if (stub) *stub = &entry->stub;
+done:
+    ReleaseSRWLockExclusive(&tables_lock);
+    return hr;
+}
