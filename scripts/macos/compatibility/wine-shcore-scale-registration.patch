+{
+    struct scale_change_registration *next;
+    IUnknown *sink;
+    DWORD cookie;
+};
+
+static SRWLOCK scale_change_lock = SRWLOCK_INIT;
+static struct scale_change_registration *scale_change_registrations;
+static DWORD scale_change_cookie;
 
 /* CW Hack 22310 */
