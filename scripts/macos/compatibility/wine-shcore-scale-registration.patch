+HRESULT WINAPI RegisterScaleChangeSinkForWindow(void *window, void *sink, DWORD *cookie)
+{
+    struct scale_change_registration *registration;
+
+    FIXME("window %p, sink %p, cookie %p: fixed scale 100; change notifications are never sent.\n",
+          window, sink, cookie);
+    if (!cookie) return E_INVALIDARG;
+    *cookie = 0;
+    if (!sink) return E_INVALIDARG;
+    if (!(registration = malloc(sizeof(*registration)))) return E_OUTOFMEMORY;
+
+    registration->sink = sink;
+    IUnknown_AddRef(registration->sink);
+    AcquireSRWLockExclusive(&scale_change_lock);
+    if (scale_change_cookie == MAXDWORD)
+    {
+        ReleaseSRWLockExclusive(&scale_change_lock);
+        IUnknown_Release(registration->sink);
+        free(registration);
+        return HRESULT_FROM_WIN32(ERROR_NO_SYSTEM_RESOURCES);
+    }
+    registration->cookie = ++scale_change_cookie;
+    registration->next = scale_change_registrations;
+    scale_change_registrations = registration;
+    *cookie = registration->cookie;
+    ReleaseSRWLockExclusive(&scale_change_lock);
+    return S_OK;
+}
+
+HRESULT WINAPI RevokeScaleChangeNotificationsForWindow(void *window, DWORD cookie)
+{
+    struct scale_change_registration *registration, **cursor;
+
+    TRACE("window %p, cookie %lu.\n", window, cookie);
+    AcquireSRWLockExclusive(&scale_change_lock);
+    for (cursor = &scale_change_registrations; *cursor; cursor = &(*cursor)->next)
+        if ((*cursor)->cookie == cookie) break;
+    if (!(registration = *cursor))
+    {
+        ReleaseSRWLockExclusive(&scale_change_lock);
+        WARN("Unknown scale-change registration cookie %lu.\n", cookie);
+        return E_INVALIDARG;
+    }
+    *cursor = registration->next;
+    ReleaseSRWLockExclusive(&scale_change_lock);
+    IUnknown_Release(registration->sink);
+    free(registration);
+    return S_OK;
+}
