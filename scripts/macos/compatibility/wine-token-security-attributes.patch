 /***********************************************************************
  *             NtQueryInformationToken  (NTDLL.@)
  */
+NTSTATUS WINAPI NtQuerySecurityAttributesToken( HANDLE token, UNICODE_STRING *attributes,
+                                                ULONG count, void *buffer, ULONG length, ULONG *retlen )
+{
+    struct tsa_name names[TSA_MAX_ATTRS];
+    void *data = NULL;
+    unsigned int bytes = 0, allocated = 0, i, attempt;
+    uint32_t required;
+    NTSTATUS status;
+
+    if (!retlen || count > TSA_MAX_ATTRS || (count && !attributes) ||
+        (sizeof(void *) == 8 && !count && attributes))
+        return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < count; ++i)
+    {
+        if (!attributes[i].Buffer || !attributes[i].Length || (attributes[i].Length & 1))
+            return STATUS_INVALID_PARAMETER;
+        names[i].text = attributes[i].Buffer;
+        names[i].bytes = attributes[i].Length;
+    }
+    for (attempt = 0; attempt < 3; ++attempt)
+    {
+        SERVER_START_REQ( get_token_security_attributes )
+        {
+            req->handle = wine_server_obj_handle( token );
+            if (allocated) wine_server_set_reply( req, data, allocated );
+            status = wine_server_call( req );
+            bytes = reply->attributes_len;
+        }
+        SERVER_END_REQ;
+        if (status != STATUS_BUFFER_TOO_SMALL) break;
+        if (bytes < sizeof(struct tsa_header) || bytes > TSA_MAX_BYTES)
+        {
+            status = STATUS_INVALID_PARAMETER;
+            break;
+        }
+        free( data );
+        allocated = bytes;
+        if (!(data = malloc( allocated )))
+        {
+            status = STATUS_NO_MEMORY;
+            break;
+        }
+    }
+    if (!status)
+    {
+        status = tsa_query( data, bytes, count ? names : NULL, count, buffer, length, &required );
+        *retlen = required;
+    }
+    free( data );
+    return status;
+}
+
