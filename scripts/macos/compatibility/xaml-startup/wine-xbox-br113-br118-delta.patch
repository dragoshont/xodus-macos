 /***********************************************************************
+ *      RoGetMatchingRestrictedErrorInfo (combase.@)
+ *
+ * Returns the thread's restricted error info when it matches the HRESULT,
+ * otherwise originates a matching one.  Restricted error info is not stored
+ * (GetRestrictedErrorInfo/SetRestrictedErrorInfo) nor originated
+ * (RoOriginateError returns FALSE), so there is none to return.
+ */
+HRESULT WINAPI RoGetMatchingRestrictedErrorInfo(HRESULT error, IRestrictedErrorInfo **info)
+{
+    FIXME("%#lx, %p: restricted error info not supported\n", error, info);
+    if (!info) return E_POINTER;
+    *info = NULL;
+    return E_NOTIMPL;
+}
