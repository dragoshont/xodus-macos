+
+/* PROCESS_UICONTEXT_INFORMATION layout from the Windows SDK winuser.h */
+struct process_uicontext_information
+{
+    DWORD context; /* PROCESS_UICONTEXT: 0 desktop, 1 immersive, 2 immersive browser */
+    DWORD flags;   /* PROCESS_UIF_* */
+};
+
+/***********************************************************************
+ *		GetProcessUIContextInformation (USER32.@)
+ *
+ * Native reports PROCESS_UICONTEXT_IMMERSIVE only for immersive (AppContainer)
+ * processes. Wine tokens are never AppContainers (TokenIsAppContainer is 0),
+ * so every Wine process is in the desktop UI context.
+ */
+BOOL WINAPI GetProcessUIContextInformation( HANDLE process, struct process_uicontext_information *info )
+{
+    TRACE( "(%p, %p)\n", process, info );
+    if (!info)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    info->context = 0;
+    info->flags = 0;
+    return TRUE;
+}
