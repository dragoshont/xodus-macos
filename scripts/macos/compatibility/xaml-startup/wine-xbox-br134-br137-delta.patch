+static HRESULT delete_tree( const WCHAR *path )
+{
+    WIN32_FIND_DATAW data;
+    WCHAR *pattern, *child;
+    HRESULT hr = S_OK;
+    size_t len = wcslen( path );
+    HANDLE find;
+
+    if (!(pattern = malloc( (len + 3) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( pattern, len + 3, L"%s\\*", path );
+    find = FindFirstFileW( pattern, &data );
+    free( pattern );
+    if (find != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (!wcscmp( data.cFileName, L"." ) || !wcscmp( data.cFileName, L".." )) continue;
+            if (!(child = malloc( (len + wcslen( data.cFileName ) + 2) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; break; }
+            swprintf( child, len + wcslen( data.cFileName ) + 2, L"%s\\%s", path, data.cFileName );
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) hr = delete_tree( child );
+            else if (!DeleteFileW( child )) hr = HRESULT_FROM_WIN32( GetLastError() );
+            free( child );
+        } while (SUCCEEDED(hr) && FindNextFileW( find, &data ));
+        FindClose( find );
+    }
+    if (SUCCEEDED(hr) && !RemoveDirectoryW( path )) hr = HRESULT_FROM_WIN32( GetLastError() );
+    return hr;
+}
+
+static HRESULT create_folder_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct storage_folder *folder = impl_from_IStorageFolder( (IStorageFolder *)param );
+    DWORD attrs, err;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+
+    TRACE( "creating %s, option %d.\n", debugstr_w( folder->path ), folder->create_option );
+
+    if (CreateDirectoryW( folder->path, NULL )) goto done;
+    if ((err = GetLastError()) != ERROR_ALREADY_EXISTS) return HRESULT_FROM_WIN32( err );
+
+    switch (folder->create_option)
+    {
+    case CreationCollisionOption_OpenIfExists:
+        attrs = GetFileAttributesW( folder->path );
+        if (attrs == INVALID_FILE_ATTRIBUTES || !(attrs & FILE_ATTRIBUTE_DIRECTORY)) return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+        break;
+    case CreationCollisionOption_ReplaceExisting:
+        attrs = GetFileAttributesW( folder->path );
+        if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY)) hr = delete_tree( folder->path );
+        else hr = DeleteFileW( folder->path ) ? S_OK : HRESULT_FROM_WIN32( GetLastError() );
+        if (FAILED(hr)) return hr;
+        if (!CreateDirectoryW( folder->path, NULL )) return HRESULT_FROM_WIN32( GetLastError() );
+        break;
+    case CreationCollisionOption_GenerateUniqueName:
+    {
+        size_t len = wcslen( folder->path ) + 16;
+        WCHAR *path;
+        UINT i;
+
+        if (!(path = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        for (i = 2; i < 10000; i++)
+        {
+            swprintf( path, len, L"%s (%u)", folder->path, i );
+            if (CreateDirectoryW( path, NULL )) break;
+            if ((err = GetLastError()) != ERROR_ALREADY_EXISTS) { free( path ); return HRESULT_FROM_WIN32( err ); }
+        }
+        if (i == 10000) { free( path ); return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS ); }
+        free( folder->path );
+        folder->path = path;
+        break;
+    }
+    default:
+        return HRESULT_FROM_WIN32( ERROR_ALREADY_EXISTS );
+    }
+
+done:
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)&folder->IStorageFolder_iface;
+    IUnknown_AddRef( result->punkVal );
+    return S_OK;
+}
