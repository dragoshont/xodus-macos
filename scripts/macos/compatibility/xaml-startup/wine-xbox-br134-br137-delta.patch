+static HRESULT create_data_container( const WCHAR *name, UINT32 name_len, ApplicationDataLocality locality,
+                                      struct data_container **out )
+{
+    static const WCHAR property_set_name[] = L"Windows.Foundation.Collections.PropertySet";
+    struct data_container *impl;
+    IInspectable *inspectable;
+    HSTRING class_name;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (!(impl->name = calloc( name_len + 1, sizeof(WCHAR) )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( impl->name, name, name_len * sizeof(WCHAR) );
+
+    if (SUCCEEDED(hr = WindowsCreateString( property_set_name, wcslen( property_set_name ), &class_name )))
+    {
+        if (SUCCEEDED(hr = RoActivateInstance( class_name, &inspectable )))
+        {
+            hr = IInspectable_QueryInterface( inspectable, &IID_IPropertySet, (void **)&impl->values );
+            IInspectable_Release( inspectable );
+        }
+        WindowsDeleteString( class_name );
+    }
+    if (FAILED(hr))
+    {
+        free( impl->name );
+        free( impl );
+        return hr;
+    }
+
+    impl->IApplicationDataContainer_iface.lpVtbl = &data_container_vtbl;
+    impl->ref = 1;
+    impl->locality = locality;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": data_container.cs");
+    list_init( &impl->children );
+    *out = impl;
+    return S_OK;
+}
