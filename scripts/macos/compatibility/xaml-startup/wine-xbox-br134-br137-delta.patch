+}
+static HRESULT create_package_folder( const WCHAR *subdir, IStorageFolder **value )
+{
+    WCHAR family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1], base[MAX_PATH], path[MAX_PATH];
+    struct storage_folder *impl;
+    UINT32 length = ARRAY_SIZE(family);
+    LONG result;
+    DWORD len;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if ((result = GetCurrentPackageFamilyName( &length, family ))) return HRESULT_FROM_WIN32( result );
+    if (!(len = GetEnvironmentVariableW( L"LOCALAPPDATA", base, ARRAY_SIZE(base) )) || len >= ARRAY_SIZE(base))
+        return HRESULT_FROM_WIN32( ERROR_PATH_NOT_FOUND );
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Packages", base );
+    CreateDirectoryW( path, NULL );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Packages\\%s", base, family );
+    CreateDirectoryW( path, NULL );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Packages\\%s\\%s", base, family, subdir );
+    if (!CreateDirectoryW( path, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return HRESULT_FROM_WIN32( GetLastError() );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (!(impl->path = wcsdup( path )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    impl->IStorageFolder_iface.lpVtbl = &storage_folder_vtbl;
+    impl->IStorageItem_iface.lpVtbl = &storage_item_vtbl;
+    impl->ref = 1;
+    *value = &impl->IStorageFolder_iface;
+    TRACE( "created folder %s -> %p\n", debugstr_w( path ), *value );
+    return S_OK;
+}
