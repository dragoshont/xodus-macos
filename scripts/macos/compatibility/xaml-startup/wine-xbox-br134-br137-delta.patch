+static HRESULT WINAPI storage_folder_CreateFolderAsync( IStorageFolder *iface, HSTRING name, CreationCollisionOption options,
+                                                        IAsyncOperation_StorageFolder **operation )
+{
+    struct storage_folder *impl = impl_from_IStorageFolder( iface ), *child;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, NULL );
+    size_t len;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, options %d, operation %p.\n", iface, debugstr_hstring(name), options, operation );
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!str[0] || wcspbrk( str, L"\\/:*?\"<>|" ) || !wcscmp( str, L"." ) || !wcscmp( str, L".." )) return E_INVALIDARG;
+    if (options < CreationCollisionOption_GenerateUniqueName || options > CreationCollisionOption_OpenIfExists) return E_INVALIDARG;
+
+    if (!(child = calloc( 1, sizeof(*child) ))) return E_OUTOFMEMORY;
+    len = wcslen( impl->path ) + wcslen( str ) + 2;
+    if (!(child->path = malloc( len * sizeof(WCHAR) )))
+    {
+        free( child );
+        return E_OUTOFMEMORY;
+    }
+    swprintf( child->path, len, L"%s\\%s", impl->path, str );
+    child->IStorageFolder_iface.lpVtbl = &storage_folder_vtbl;
+    child->IStorageItem_iface.lpVtbl = &storage_item_vtbl;
+    child->ref = 1;
+    child->create_option = options;
+
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_StorageFolder, (IUnknown *)iface, (IUnknown *)&child->IStorageFolder_iface,
+                                             create_folder_async, (IAsyncOperation_IInspectable **)operation );
+    IStorageFolder_Release( &child->IStorageFolder_iface );
+    return hr;
+}
