+static HRESULT WINAPI data_container_CreateContainer( IApplicationDataContainer *iface, HSTRING name,
+                                                      ApplicationDataCreateDisposition disposition,
+                                                      IApplicationDataContainer **container )
+{
+    struct data_container *impl = impl_from_IApplicationDataContainer( iface ), *child;
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, &len );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, name %s, disposition %d, container %p.\n", iface, debugstr_hstring( name ), disposition, container );
+
+    if (!container) return E_POINTER;
+    *container = NULL;
+    if (!len || len > 255) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( child, &impl->children, struct data_container, entry )
+    {
+        if (wcslen( child->name ) == len && !wcsnicmp( child->name, str, len ))
+        {
+            *container = &child->IApplicationDataContainer_iface;
+            IApplicationDataContainer_AddRef( *container );
+            break;
+        }
+    }
+    if (!*container)
+    {
+        if (disposition == ApplicationDataCreateDisposition_Existing)
+            hr = HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+        else if (SUCCEEDED(hr = create_data_container( str, len, impl->locality, &child )))
+        {
+            list_add_tail( &impl->children, &child->entry );
+            *container = &child->IApplicationDataContainer_iface;
+            IApplicationDataContainer_AddRef( *container );
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI data_container_DeleteContainer( IApplicationDataContainer *iface, HSTRING name )
+{
+    struct data_container *impl = impl_from_IApplicationDataContainer( iface ), *child;
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, &len );
+
+    TRACE( "iface %p, name %s.\n", iface, debugstr_hstring( name ) );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( child, &impl->children, struct data_container, entry )
+    {
+        if (wcslen( child->name ) == len && !wcsnicmp( child->name, str, len ))
+        {
+            list_remove( &child->entry );
+            IApplicationDataContainer_Release( &child->IApplicationDataContainer_iface );
+            break;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
