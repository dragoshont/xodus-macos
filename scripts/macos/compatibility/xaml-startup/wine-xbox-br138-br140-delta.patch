+/*************************************************************************
+ * SHCreateMemoryStreamOnSharedBuffer   [SHCORE.270]
+ *
+ * Creates an IStream over the bytes exposed by a buffer object whose first
+ * method after IUnknown returns the data pointer (IBufferByteAccess layout).
+ * The stream does not copy the data; it keeps a reference on the buffer.
+ */
+HRESULT WINAPI SHCreateMemoryStreamOnSharedBuffer(IUnknown *buffer, DWORD size, IStream **out)
+{
+    struct sharedbuf_stream *shared;
+    BYTE *data = NULL;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %p.\n", buffer, size, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!buffer) return E_INVALIDARG;
+
+    if (!(shared = calloc(1, sizeof(*shared)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = ((buffer_byte_access *)buffer)->lpVtbl->Buffer(buffer, &data)))
+    {
+        free(shared);
+        return hr;
+    }
+
+    shared->stream.IStream_iface.lpVtbl = &sharedbufstreamvtbl;
+    shared->IAccessPrivateBuffer_iface.lpVtbl = (void *)&access_private_buffer_vtbl;
+    shared->stream.refcount = 1;
+    shared->stream.u.mem.buffer = data;
+    shared->stream.u.mem.length = size;
+    shared->stream.u.mem.position = 0;
+    shared->capacity = size;
+    shared->owner = buffer;
+    IUnknown_AddRef(buffer);
+
+    *out = &shared->stream.IStream_iface;
+    return S_OK;
+}
