+/* {ed3071e9-f556-4c46-9294-6640c8c75281}, IAccessPrivateBuffer (shcore CMemStream, measured) */
+static const GUID IID_IAccessPrivateBuffer = {0xed3071e9, 0xf556, 0x4c46, {0x92, 0x94, 0x66, 0x40, 0xc8, 0xc7, 0x52, 0x81}};
+
+static inline struct sharedbuf_stream *sharedbuf_from_IAccessPrivateBuffer(struct access_private_buffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct sharedbuf_stream, IAccessPrivateBuffer_iface);
+}
+
+static HRESULT WINAPI sharedbuf_stream_QueryInterface(IStream *iface, REFIID riid, void **out)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    struct sharedbuf_stream *shared = CONTAINING_RECORD(stream, struct sharedbuf_stream, stream);
+
+    if (IsEqualIID(riid, &IID_IAccessPrivateBuffer))
+    {
+        *out = &shared->IAccessPrivateBuffer_iface;
+        IStream_AddRef(iface);
+        return S_OK;
+    }
+    return shstream_QueryInterface(iface, riid, out);
+}
+
+static HRESULT WINAPI access_private_buffer_QueryInterface(struct access_private_buffer *iface, REFIID riid, void **out)
+{
+    struct sharedbuf_stream *shared = sharedbuf_from_IAccessPrivateBuffer(iface);
+    return IStream_QueryInterface(&shared->stream.IStream_iface, riid, out);
+}
+
+static ULONG WINAPI access_private_buffer_AddRef(struct access_private_buffer *iface)
+{
+    struct sharedbuf_stream *shared = sharedbuf_from_IAccessPrivateBuffer(iface);
+    return IStream_AddRef(&shared->stream.IStream_iface);
+}
+
+static ULONG WINAPI access_private_buffer_Release(struct access_private_buffer *iface)
+{
+    struct sharedbuf_stream *shared = sharedbuf_from_IAccessPrivateBuffer(iface);
+    return IStream_Release(&shared->stream.IStream_iface);
+}
+
+/* Native CMemStream::GetPrivateBuffer returns the whole buffer (not position
+ * relative) and E_UNEXPECTED when there is no backing data. */
+static HRESULT WINAPI access_private_buffer_GetPrivateBuffer(struct access_private_buffer *iface, UINT *size, const BYTE **buffer)
+{
+    struct sharedbuf_stream *shared = sharedbuf_from_IAccessPrivateBuffer(iface);
+
+    TRACE("%p, %p, %p.\n", iface, size, buffer);
+
+    *size = shared->stream.u.mem.length;
+    *buffer = shared->stream.u.mem.buffer;
+    return shared->stream.u.mem.buffer ? S_OK : E_UNEXPECTED;
+}
+
+static const struct
+{
+    HRESULT (WINAPI *QueryInterface)(struct access_private_buffer *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(struct access_private_buffer *);
+    ULONG (WINAPI *Release)(struct access_private_buffer *);
+    HRESULT (WINAPI *GetPrivateBuffer)(struct access_private_buffer *, UINT *, const BYTE **);
+} access_private_buffer_vtbl =
+{
+    access_private_buffer_QueryInterface,
+    access_private_buffer_AddRef,
+    access_private_buffer_Release,
+    access_private_buffer_GetPrivateBuffer,
+};
+
+static ULONG WINAPI sharedbuf_stream_Release(IStream *iface)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    struct sharedbuf_stream *shared = CONTAINING_RECORD(stream, struct sharedbuf_stream, stream);
+    ULONG refcount = InterlockedDecrement(&stream->refcount);
+
+    TRACE("%p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        IUnknown_Release(shared->owner);
+        free(shared);
+    }
+
+    return refcount;
 }
 
+static HRESULT WINAPI sharedbuf_stream_Write(IStream *iface, const void *buff, ULONG buff_size, ULONG *written)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    struct sharedbuf_stream *shared = CONTAINING_RECORD(stream, struct sharedbuf_stream, stream);
+    DWORD end = stream->u.mem.position + buff_size;
+
+    TRACE("%p, %p, %lu, %p.\n", iface, buff, buff_size, written);
+
+    if (written) *written = 0;
+    if (end < stream->u.mem.position || end > shared->capacity)
+        return STG_E_MEDIUMFULL;
+
+    memmove(stream->u.mem.buffer + stream->u.mem.position, buff, buff_size);
+    stream->u.mem.position = end;
+    if (end > stream->u.mem.length) stream->u.mem.length = end;
+    if (written) *written = buff_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI sharedbuf_stream_SetSize(IStream *iface, ULARGE_INTEGER new_size)
+{
+    struct shstream *stream = impl_from_IStream(iface);
+    struct sharedbuf_stream *shared = CONTAINING_RECORD(stream, struct sharedbuf_stream, stream);
+
+    TRACE("%p, %s.\n", iface, wine_dbgstr_longlong(new_size.QuadPart));
+
+    if (new_size.QuadPart > shared->capacity)
+        return STG_E_MEDIUMFULL;
+    stream->u.mem.length = new_size.u.LowPart;
+    return S_OK;
+}
+
+static const IStreamVtbl sharedbufstreamvtbl =
