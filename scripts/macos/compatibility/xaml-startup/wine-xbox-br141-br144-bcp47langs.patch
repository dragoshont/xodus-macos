+static HRESULT get_preferred_languages(WCHAR delim, HSTRING *langs)
+{
+    ULONG count = 0, size = 0, len;
+    WCHAR *buffer, *p;
+    HRESULT hr;
+
+    if (!GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, NULL, &size))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(buffer = malloc(size * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    if (!GetUserPreferredUILanguages(MUI_LANGUAGE_NAME, &count, buffer, &size))
+    {
+        free(buffer);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+
+    /* MULTI_SZ -> delimited list */
+    for (p = buffer; *p; p += wcslen(p) + 1)
+        if (p[wcslen(p) + 1]) p[wcslen(p)] = delim;
+    len = wcslen(buffer);
+    hr = WindowsCreateString(buffer, len, langs);
+    free(buffer);
+    return hr;
+}
