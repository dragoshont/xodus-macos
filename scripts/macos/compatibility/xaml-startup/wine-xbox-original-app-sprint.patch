+
+static void test_far_relative_due_time(void)
+{
+    static const LONGLONG due_times[] = { 0x8000000000000001ll, 0x8000000000000000ll };
+    LARGE_INTEGER due;
+    unsigned int i;
+    HANDLE timer;
+    DWORD ret;
+
+    for (i = 0; i < ARRAY_SIZE(due_times); i++)
+    {
+        timer = CreateWaitableTimerW( NULL, TRUE, NULL );
+        ok( timer != NULL, "CreateWaitableTimer failed, error %lu\n", GetLastError() );
+
+        due.QuadPart = 0;
+        ok( SetWaitableTimer( timer, &due, 0, NULL, NULL, FALSE ), "SetWaitableTimer failed\n" );
+        ret = WaitForSingleObject( timer, 1000 );
+        ok( ret == WAIT_OBJECT_0, "got %lu\n", ret );
+
+        /* re-arming a signaled notification timer with a far relative due time resets it */
+        due.QuadPart = due_times[i];
+        ok( SetWaitableTimer( timer, &due, 0, NULL, NULL, FALSE ), "SetWaitableTimer failed\n" );
+        ret = WaitForSingleObject( timer, 100 );
+        ok( ret == WAIT_TIMEOUT, "%u: got %lu\n", i, ret );
+        CloseHandle( timer );
+    }
 }
 
 START_TEST(timer)
 {
     test_timer();
     test_timeouts();
+    test_far_relative_due_time();
 }
