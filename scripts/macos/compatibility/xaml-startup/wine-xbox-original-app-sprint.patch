+/* Package publisher ids are the first 64 bits of SHA-256 over the UTF-16LE
+ * publisher name, encoded as 13 Crockford base32 characters. */
+static HRESULT publisher_id_from_publisher( const WCHAR *publisher, WCHAR *publisher_id )
+{
+    static const WCHAR alphabet[] = L"0123456789abcdefghjkmnpqrstvwxyz";
+    UCHAR hash[32];
+    UINT64 bits = 0;
+    NTSTATUS status;
+    unsigned int i;
+
+    if ((status = BCryptHash( BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (UCHAR *)publisher,
+                              wcslen( publisher ) * sizeof(WCHAR), hash, sizeof(hash) )))
+        return HRESULT_FROM_NT( status );
+    for (i = 0; i < 8; i++) bits = (bits << 8) | hash[i];
+    for (i = 0; i < 12; i++) publisher_id[i] = alphabet[(bits >> (59 - 5 * i)) & 0x1f];
+    publisher_id[12] = alphabet[(bits & 0xf) << 1];
+    publisher_id[13] = 0;
+    return S_OK;
+}
+
+static WCHAR *manifest_attribute( const WCHAR *element, const WCHAR *end, const WCHAR *name )
+{
+    size_t name_len = wcslen( name ), len;
+    const WCHAR *p, *value, *value_end;
+    WCHAR *result, *out;
+
+    for (p = element; p + name_len < end; p++)
+    {
+        if ((p[-1] != ' ' && p[-1] != '\t' && p[-1] != '\r' && p[-1] != '\n') ||
+            wcsncmp( p, name, name_len )) continue;
+        value = p + name_len;
+        while (value < end && (*value == ' ' || *value == '\t' || *value == '\r' || *value == '\n')) value++;
+        if (value >= end || *value++ != '=') continue;
+        while (value < end && (*value == ' ' || *value == '\t' || *value == '\r' || *value == '\n')) value++;
+        if (value >= end || (*value != '"' && *value != '\'')) continue;
+        for (value_end = value + 1; value_end < end && *value_end != *value; value_end++);
+        if (value_end >= end) return NULL;
+        value++;
+        len = value_end - value;
+        if (!(result = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+        for (out = result; value < value_end; value++)
+        {
+            static const struct { const WCHAR *entity; WCHAR ch; } entities[] =
+                { {L"&amp;", '&'}, {L"&lt;", '<'}, {L"&gt;", '>'}, {L"&quot;", '"'}, {L"&apos;", '\''} };
+            unsigned int i;
+            if (*value == '&')
+            {
+                for (i = 0; i < ARRAY_SIZE(entities); i++)
+                {
+                    size_t entity_len = wcslen( entities[i].entity );
+                    if (value + entity_len <= value_end && !wcsncmp( value, entities[i].entity, entity_len ))
+                    {
+                        *out++ = entities[i].ch;
+                        value += entity_len - 1;
+                        break;
+                    }
+                }
+                if (i == ARRAY_SIZE(entities)) { free( result ); return NULL; }
+                continue;
+            }
+            *out++ = *value;
+        }
+        *out = 0;
+        return result;
+    }
+    return NULL;
+}
