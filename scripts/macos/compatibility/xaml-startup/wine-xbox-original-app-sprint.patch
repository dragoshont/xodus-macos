+HRESULT json_writer_append( struct json_writer *writer, const WCHAR *str, UINT32 len )
+{
+    if (len > writer->capacity - writer->len)
+    {
+        UINT32 capacity = max( 64, writer->capacity );
+        WCHAR *buf;
+
+        while (len > capacity - writer->len)
+        {
+            if (capacity > UINT_MAX / 2 / sizeof(WCHAR)) return E_OUTOFMEMORY;
+            capacity *= 2;
+        }
+        if (!(buf = realloc( writer->buf, capacity * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        writer->buf = buf;
+        writer->capacity = capacity;
+    }
+
+    memcpy( writer->buf + writer->len, str, len * sizeof(WCHAR) );
+    writer->len += len;
+    return S_OK;
+}
+
+HRESULT json_writer_finish( struct json_writer *writer, HRESULT hr, HSTRING *out )
+{
+    if (SUCCEEDED(hr)) hr = WindowsCreateString( writer->buf, writer->len, out );
+    free( writer->buf );
+    writer->buf = NULL;
+    writer->len = writer->capacity = 0;
+    return hr;
+}
+
+/* Windows.Web escapes only quote, backslash and C0 controls; '/' and non-ASCII are written as-is. */
+HRESULT json_write_string( struct json_writer *writer, const WCHAR *str, UINT32 len )
+{
+    static const WCHAR hex[] = L"0123456789ABCDEF";
+    UINT32 i, start = 0;
+    WCHAR escape[6];
+    HRESULT hr;
+
+    if (FAILED(hr = json_writer_append( writer, L"\"", 1 ))) return hr;
+
+    for (i = 0; i < len; i++)
+    {
+        UINT32 escape_len = 2;
+        WCHAR chr = str[i];
+
+        if (chr != '"' && chr != '\\' && chr >= 0x20) continue;
+        if (FAILED(hr = json_writer_append( writer, str + start, i - start ))) return hr;
+        start = i + 1;
+
+        escape[0] = '\\';
+        switch (chr)
+        {
+        case '"':  escape[1] = '"'; break;
+        case '\\': escape[1] = '\\'; break;
+        case '\b': escape[1] = 'b'; break;
+        case '\f': escape[1] = 'f'; break;
+        case '\n': escape[1] = 'n'; break;
+        case '\r': escape[1] = 'r'; break;
+        case '\t': escape[1] = 't'; break;
+        default:
+            escape[1] = 'u';
+            escape[2] = '0';
+            escape[3] = '0';
+            escape[4] = hex[(chr >> 4) & 0xf];
+            escape[5] = hex[chr & 0xf];
+            escape_len = 6;
+            break;
+        }
+        if (FAILED(hr = json_writer_append( writer, escape, escape_len ))) return hr;
+    }
+
+    if (FAILED(hr = json_writer_append( writer, str + start, len - start ))) return hr;
+    return json_writer_append( writer, L"\"", 1 );
+}
