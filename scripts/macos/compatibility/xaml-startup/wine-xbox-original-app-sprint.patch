+/* Windows.Web uses the shortest of 15 or 17 significant digits that round-trips, an
+ * uppercase exponent without zero padding, and legacy MSVCRT spellings for non-finite values. */
+static HRESULT json_write_number( struct json_writer *writer, double value )
+{
+    char buf[64], *exponent;
+    WCHAR out[64];
+    UINT64 bits;
+    UINT32 i, len = 0;
+
+    memcpy( &bits, &value, sizeof(bits) );
+    if (((bits >> 52) & 0x7ff) == 0x7ff)
+    {
+        const char *text;
+
+        /* matches native MSVC-style special value names */
+        if (bits == 0xfff8000000000000ull) text = "-1.#IND";
+        else if (!(bits & (((UINT64)1 << 52) - 1))) text = (bits >> 63) ? "-1.#INF" : "1.#INF";
+        else if (bits & ((UINT64)1 << 51)) text = (bits >> 63) ? "-1.#QNAN" : "1.#QNAN";
+        else text = (bits >> 63) ? "-1.#SNAN" : "1.#SNAN";
+        strcpy( buf, text );
+    }
+    else
+    {
+        snprintf( buf, sizeof(buf), "%.15g", value );
+        if (strtod( buf, NULL ) != value) snprintf( buf, sizeof(buf), "%.17g", value );
+    }
+
+    exponent = strchr( buf, 'e' );
+    for (i = 0; buf[i] && (!exponent || buf + i < exponent); i++) out[len++] = buf[i];
+    if (exponent)
+    {
+        const char *digits = exponent + 1;
+
+        out[len++] = 'E';
+        if (*digits == '+' || *digits == '-') out[len++] = *digits++;
+        while (digits[0] == '0' && digits[1]) digits++;
+        while (*digits) out[len++] = *digits++;
+    }
+
+    return json_writer_append( writer, out, len );
+}
