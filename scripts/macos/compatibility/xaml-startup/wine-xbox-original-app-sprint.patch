+static HRESULT uisettings_add_handler( struct uisettings *impl, struct list *list, IUnknown *handler,
+                                       EventRegistrationToken *token )
+{
+    static LONG once;
+    struct uisettings_event_handler *entry;
+
+    token->value = 0;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = malloc( sizeof(*entry) ))) return E_OUTOFMEMORY;
+
+    if (!InterlockedExchange( &once, 1 ))
+        FIXME( "UISettings change notifications are not delivered; registered handlers are not invoked.\n" );
+
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+    entry->token.value = InterlockedIncrement64( &uisettings_next_token );
+
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( list, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT uisettings_remove_handler( struct uisettings *impl, struct list *list, EventRegistrationToken token )
+{
+    struct uisettings_event_handler *entry, *found = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, list, struct uisettings_event_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    if (found)
+    {
+        IUnknown_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+static void uisettings_free_handlers( struct list *list )
+{
+    struct uisettings_event_handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct uisettings_event_handler, entry )
+    {
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+    }
+}
