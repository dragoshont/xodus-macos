+/* Per-package application data state (api-ms-win-appmodel-state-l1-2-0).
+ * Measured on Windows 11 26100.9278: OpenState fails with APPMODEL_ERROR_NO_PACKAGE
+ * without package identity; GetStateFolder resolves under the token user's profile
+ * (not %LOCALAPPDATA%) and never creates folders. */
+#define APPMODEL_STATE_MAGIC 0x54535041
+
+struct appmodel_state
+{
+    DWORD magic;
+    WCHAR family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+};
+
+HANDLE WINAPI OpenState( void );
+BOOL WINAPI CloseState( HANDLE handle );
+BOOL WINAPI GetStateFolder( HANDLE handle, int type, WCHAR *path, UINT32 *length );
+
+/***********************************************************************
+ *         OpenState   (kernelbase.@)
+ */
+HANDLE WINAPI OpenState( void )
+{
+    struct appmodel_state *state;
+    WCHAR family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    UINT32 length = ARRAY_SIZE(family);
+    LONG result;
+
+    TRACE( "()\n" );
+    if ((result = GetCurrentPackageFamilyName( &length, family )))
+    {
+        SetLastError( result );
+        return NULL;
+    }
+    if (!(state = HeapAlloc( GetProcessHeap(), 0, sizeof(*state) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    state->magic = APPMODEL_STATE_MAGIC;
+    memcpy( state->family, family, length * sizeof(WCHAR) );
+    SetLastError( ERROR_SUCCESS );
+    return state;
+}
+
+/***********************************************************************
+ *         CloseState   (kernelbase.@)
+ */
+BOOL WINAPI CloseState( HANDLE handle )
+{
+    struct appmodel_state *state = handle;
+
+    TRACE( "(%p)\n", handle );
+    if (!state || state->magic != APPMODEL_STATE_MAGIC)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    state->magic = 0;
+    HeapFree( GetProcessHeap(), 0, state );
+    SetLastError( ERROR_SUCCESS );
+    return TRUE;
+}
