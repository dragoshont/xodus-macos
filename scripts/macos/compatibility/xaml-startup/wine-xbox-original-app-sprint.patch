+/* SetWindowFeedbackSetting / GetWindowFeedbackSetting state is per window and per process. */
+static BOOL set_window_feedback_setting( HWND hwnd, const struct window_feedback_params *params )
+{
+    UINT bit = 1u << params->type;
+    WND *win;
+
+    if (!(win = get_win_ptr( hwnd )))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (win == WND_OTHER_PROCESS || win == WND_DESKTOP)
+    {
+        if (win == WND_OTHER_PROCESS && !is_window( hwnd )) return FALSE;
+        RtlSetLastWin32Error( 0 );
+        return FALSE;
+    }
+    if (params->reset) win->feedback_set &= ~bit;
+    else
+    {
+        win->feedback_set |= bit;
+        if (params->value) win->feedback_value |= bit;
+        else win->feedback_value &= ~bit;
+    }
+    release_win_ptr( win );
+    return TRUE;
+}
+
+static BOOL get_window_feedback_setting( HWND hwnd, struct window_feedback_params *params )
+{
+    UINT bit = params->type < 32 ? 1u << params->type : 0;
+    BOOL found = FALSE;
+    WND *win;
+
+    params->value = FALSE;
+    params->invalid = FALSE;
+    if (!hwnd)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+        params->invalid = TRUE;
+        return FALSE;
+    }
+    while (hwnd)
+    {
+        if (!(win = get_win_ptr( hwnd )))
+        {
+            RtlSetLastWin32Error( ERROR_INVALID_WINDOW_HANDLE );
+            params->invalid = TRUE;
+            return FALSE;
+        }
+        if (win == WND_OTHER_PROCESS || win == WND_DESKTOP)
+        {
+            if (win == WND_OTHER_PROCESS && !is_window( hwnd )) params->invalid = TRUE;
+            break;
+        }
+        if (win->feedback_set & bit)
+        {
+            params->value = !!(win->feedback_value & bit);
+            found = TRUE;
+        }
+        hwnd = win->parent;
+        release_win_ptr( win );
+        if (found || !params->include_ancestors) break;
+    }
+    return found;
+}
