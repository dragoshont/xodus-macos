+static HRESULT current_package_string( LONG (WINAPI *get)(UINT32 *, WCHAR *), WCHAR **value )
+{
+    UINT32 length = 0;
+    LONG error;
+
+    if ((error = get( &length, NULL )) != ERROR_INSUFFICIENT_BUFFER)
+        return HRESULT_FROM_WIN32( error ? error : ERROR_INVALID_DATA );
+    if (!(*value = malloc( length * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    if ((error = get( &length, *value )))
+    {
+        free( *value );
+        *value = NULL;
+        return HRESULT_FROM_WIN32( error );
+    }
+    return S_OK;
+}
+
+static HRESULT create_package_id( IPackageId **value )
+{
+    struct package_id *impl;
+    UINT32 length = 0;
+    LONG error;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPackageId_iface.lpVtbl = &package_id_vtbl;
+    impl->ref = 1;
+
+    if (FAILED(hr = current_package_string( GetCurrentPackageFullName, &impl->full_name )) ||
+        FAILED(hr = current_package_string( GetCurrentPackageFamilyName, &impl->family_name )))
+        goto failed;
+
+    hr = HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    if (PackageIdFromFullName( impl->full_name, 0, &length, NULL ) != ERROR_INSUFFICIENT_BUFFER) goto failed;
+    if (!(impl->id = malloc( length ))) { hr = E_OUTOFMEMORY; goto failed; }
+    if ((error = PackageIdFromFullName( impl->full_name, 0, &length, (BYTE *)impl->id )))
+    {
+        hr = HRESULT_FROM_WIN32( error );
+        goto failed;
+    }
+
+    *value = &impl->IPackageId_iface;
+    TRACE( "created IPackageId %p for %s.\n", *value, debugstr_w(impl->full_name) );
+    return S_OK;
+
+failed:
+    WARN( "Failed to create package id, hr %#lx.\n", hr );
+    IPackageId_Release( &impl->IPackageId_iface );
+    return hr;
+}
