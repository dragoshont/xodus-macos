+HRESULT WINAPI GetScaleFactorForCoreWindow(IUnknown *core_window, DEVICE_SCALE_FACTOR *scale)
+{
+    static const POINT origin;
+    core_window_interop *interop;
+    HMONITOR monitor;
+    HWND hwnd = NULL;
