+static LONG get_token_user_profile( WCHAR *profile, DWORD size )
+{
+    static const WCHAR profile_list[] = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList\\";
+    union { TOKEN_USER user; BYTE buffer[SECURITY_MAX_SID_SIZE + sizeof(TOKEN_USER)]; } info;
+    WCHAR key[ARRAY_SIZE(profile_list) + 192];
+    UNICODE_STRING sid;
+    HANDLE token;
+    NTSTATUS status;
+    ULONG bytes;
+
+    if ((status = NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )))
+        return RtlNtStatusToDosError( status );
+    status = NtQueryInformationToken( token, TokenUser, &info, sizeof(info), &bytes );
+    NtClose( token );
+    if (status) return RtlNtStatusToDosError( status );
+    wcscpy( key, profile_list );
+    sid.Buffer = key + wcslen( key );
+    sid.Length = 0;
+    sid.MaximumLength = (ARRAY_SIZE(key) - wcslen( key )) * sizeof(WCHAR);
+    if ((status = RtlConvertSidToUnicodeString( &sid, info.user.User.Sid, FALSE )))
+        return RtlNtStatusToDosError( status );
+    sid.Buffer[sid.Length / sizeof(WCHAR)] = 0;
+    size *= sizeof(WCHAR);
+    return RegGetValueW( HKEY_LOCAL_MACHINE, key, L"ProfileImagePath",
+                         RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND, NULL, profile, &size );
+}
+
+/***********************************************************************
+ *         GetStateFolder   (kernelbase.@)
+ */
+BOOL WINAPI GetStateFolder( HANDLE handle, int type, WCHAR *path, UINT32 *length )
+{
+    static const WCHAR *folders[] = { NULL, L"LocalState", L"RoamingState", L"TempState", L"LocalCache" };
+    struct appmodel_state *state = handle;
+    WCHAR profile[MAX_PATH], *full;
+    UINT32 required;
+    LONG result;
+
+    TRACE( "(%p %d %p %p)\n", handle, type, path, length );
+    if (!state || state->magic != APPMODEL_STATE_MAGIC)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    if (type < 1 || type >= ARRAY_SIZE(folders) || !length)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if ((result = get_token_user_profile( profile, ARRAY_SIZE(profile) )))
+    {
+        WARN( "No profile for the token user, error %ld\n", result );
+        SetLastError( result );
+        return FALSE;
+    }
+    required = wcslen( profile ) + wcslen( L"\\AppData\\Local\\Packages\\" ) + wcslen( state->family ) + 1 +
+               wcslen( folders[type] ) + 1;
+    if (*length < required || !path)
+    {
+        *length = required;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    full = path;
+    swprintf( full, required, L"%s\\AppData\\Local\\Packages\\%s\\%s", profile, state->family, folders[type] );
+    *length = required;
+    SetLastError( ERROR_SUCCESS );
+    return TRUE;
+}
