diff -u a/dlls/combase/combase.c b/dlls/combase/combase.c
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -3501,9 +3501,109 @@
     FIXME("%p\n", object);
 
     return TRUE;
+}
+
+/* Per service-tag reference entries, as kept by native combase (CClassCache service refs). */
+struct shared_service_ref
+{
+    struct list entry;
+    DWORD id;
+    ULONG refs;
+    BOOL suspended;
+};
+
+static struct list shared_service_refs = LIST_INIT(shared_service_refs);
+
+static struct shared_service_ref *find_shared_service_ref(DWORD id)
+{
+    struct shared_service_ref *ref;
+
+    LIST_FOR_EACH_ENTRY(ref, &shared_service_refs, struct shared_service_ref, entry)
+        if (ref->id == id) return ref;
+    return NULL;
+}
+
+/***********************************************************************
+ *           CoGetSharedServiceId    (combase.66)
+ */
+HRESULT WINAPI CoGetSharedServiceId(DWORD *id)
+{
+    HRESULT hr = S_OK;
+
+    TRACE("%p\n", id);
+
+    if (!id) return E_INVALIDARG;
+    /* the service tag of the calling thread; 0 outside a shared service host */
+    *id = (DWORD)(ULONG_PTR)NtCurrentTeb()->SubProcessTag;
+
+    EnterCriticalSection(&registered_classes_cs);
+    if (!find_shared_service_ref(*id))
+    {
+        struct shared_service_ref *ref;
+
+        if ((ref = calloc(1, sizeof(*ref))))
+        {
+            ref->id = *id;
+            list_add_head(&shared_service_refs, &ref->entry);
+        }
+        else hr = E_OUTOFMEMORY;
+    }
+    LeaveCriticalSection(&registered_classes_cs);
+
+    return hr;
 }
 
 /***********************************************************************
+ *           CoAddRefSharedService    (combase.67)
+ */
+ULONG WINAPI CoAddRefSharedService(DWORD id)
+{
+    struct shared_service_ref *ref;
+    ULONG refs = ~0u;
+
+    EnterCriticalSection(&registered_classes_cs);
+    if ((ref = find_shared_service_ref(id)))
+    {
+        refs = ++ref->refs;
+        ref->suspended = FALSE;
+    }
+    else WARN("unknown shared service id %#lx\n", id);
+    LeaveCriticalSection(&registered_classes_cs);
+
+    TRACE("%#lx -> %lu\n", id, refs);
+    return refs;
+}
+
+/***********************************************************************
+ *           CoReleaseSharedService    (combase.68)
+ */
+ULONG WINAPI CoReleaseSharedService(DWORD id)
+{
+    struct shared_service_ref *ref;
+    BOOL suspend = FALSE;
+    ULONG refs = ~0u;
+
+    EnterCriticalSection(&registered_classes_cs);
+    if ((ref = find_shared_service_ref(id)))
+    {
+        refs = --ref->refs;
+        if (!refs)
+        {
+            ref->suspended = TRUE;
+            suspend = TRUE;
+        }
+    }
+    else WARN("unknown shared service id %#lx\n", id);
+    LeaveCriticalSection(&registered_classes_cs);
+
+    /* native suspends the service's local-server class objects here (all of them for id 0) */
+    if (suspend) CoSuspendClassObjects();
+
+    TRACE("%#lx -> %lu\n", id, refs);
+    return refs;
+}
+
+/***********************************************************************
  *           CoSuspendClassObjects   (combase.@)
  */
 HRESULT WINAPI CoSuspendClassObjects(void)
@@ -3590,3 +3690,16 @@
 
     return CLASS_E_CLASSNOTAVAILABLE;
 }
+
+/***********************************************************************
+ *           CoSignalPendingGitRegistrationWaits (combase.95)
+ *
+ * Native wakes STA threads blocked waiting for a cross-apartment Global
+ * Interface Table registration to complete. Wine's GIT registers interfaces
+ * synchronously under its own lock and never creates such waits, so there
+ * is nothing to signal. Last error is preserved, as on Windows 11.
+ */
+void WINAPI CoSignalPendingGitRegistrationWaits(void)
+{
+    TRACE("\n");
+}
