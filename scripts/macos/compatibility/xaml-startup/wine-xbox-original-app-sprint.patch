+static HRESULT WINAPI agg_std_unmarshaler_GetMarshalSizeMax(IMarshal *iface, REFIID riid, void *pv,
+        DWORD dest_context, void *dest_context_data, DWORD mshlflags, DWORD *size)
+{
+    return E_NOTIMPL;
+}
