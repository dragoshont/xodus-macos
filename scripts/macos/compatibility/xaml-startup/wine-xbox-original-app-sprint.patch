+            node->has_max_tested = TRUE;
+        }
+        else if (depth == 2 && dep_count && manifest_local_name_is( stack[1].name, stack[1].len, L"Dependencies" ) &&
+                 manifest_local_name_is( tag.name, tag.name_len, L"PackageDependency" ))
+        {
+            struct package_dependency *dep;
+
+            if (*dep_count >= MAX_PACKAGE_DEPENDENCIES) { ret = ERROR_NOT_SUPPORTED; goto done; }
+            dep = &deps[*dep_count];
+            if (!copy_manifest_attribute( &tag, L"Name", dep->name, ARRAY_SIZE(dep->name) ) ||
+                !copy_manifest_attribute( &tag, L"Publisher", dep->publisher, ARRAY_SIZE(dep->publisher) ) ||
+                !copy_manifest_attribute( &tag, L"MinVersion", version, ARRAY_SIZE(version) ) ||
+                !parse_package_version( version, &dep->min_version )) goto done;
+            ++*dep_count;
+        }
+        if (!tag.empty)
+        {
+            if (depth >= 64) goto done;
+            if (depth < ARRAY_SIZE(stack))
+            {
+                stack[depth].name = tag.name;
+                stack[depth].len = tag.name_len;
+            }
+            depth++;
+        }
+    }
+    if (identity) ret = ERROR_SUCCESS;
+done:
+    if (ret == ERROR_BAD_FORMAT) WARN( "Malformed package manifest %s\n", debugstr_w(path) );
+    HeapFree( GetProcessHeap(), 0, data );
+    return ret;
 }
+
+/* Wine stages packages as sibling directories of the caller's package root; pick the highest
+ * matching version like the deployment resolver does for a static PackageDependency. */
+static LONG resolve_package_dependency( const WCHAR *repository, const struct package_node *head,
+                                        const struct package_dependency *dep, struct package_node *out )
+{
+    WIN32_FIND_DATAW data;
+    WCHAR pattern[MAX_PATH], root[MAX_PATH];
+    struct package_node node;
+    BOOL found = FALSE;
+    HANDLE find;
+
+    if (wcslen( repository ) + 3 > ARRAY_SIZE(pattern)) return APPMODEL_ERROR_PACKAGE_NOT_AVAILABLE;
+    wcscpy( pattern, repository );
+    wcscat( pattern, L"\\*" );
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return APPMODEL_ERROR_PACKAGE_NOT_AVAILABLE;
+    do
+    {
+        if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+        if (wcslen( repository ) + 1 + wcslen( data.cFileName ) >= ARRAY_SIZE(root)) continue;
+        wcscpy( root, repository );
+        wcscat( root, L"\\" );
+        wcscat( root, data.cFileName );
+        if (read_package_node( root, &node, NULL, NULL )) continue;
+        if (wcsicmp( node.name, dep->name ) || wcscmp( node.publisher, dep->publisher )) continue;
+        if (wcsicmp( node.arch, head->arch ) && wcsicmp( node.arch, L"neutral" )) continue;
+        if (node.version.Version < dep->min_version.Version) continue;
+        if (found && node.version.Version <= out->version.Version) continue;
+        *out = node;
+        found = TRUE;
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+    return found ? ERROR_SUCCESS : APPMODEL_ERROR_PACKAGE_NOT_AVAILABLE;
+}
+
+static BOOL format_package_names( const struct package_node *node, const WCHAR *publisher_id,
+                                  WCHAR *full, WCHAR *family )
+{
+    WCHAR arch[16];
+    unsigned int i;
+
+    for (i = 0; node->arch[i] && i < ARRAY_SIZE(arch) - 1; i++)
+        arch[i] = node->arch[i] >= 'A' && node->arch[i] <= 'Z' ? node->arch[i] + 32 : node->arch[i];
+    arch[i] = 0;
+    if (full && _snwprintf( full, PACKAGE_FULL_NAME_MAX_LENGTH, L"%s_%u.%u.%u.%u_%s__%s", node->name,
+                            node->version.Major, node->version.Minor, node->version.Build,
+                            node->version.Revision, arch, publisher_id ) < 0) return FALSE;
+    if (family && _snwprintf( family, PACKAGE_FAMILY_NAME_MAX_LENGTH, L"%s_%s", node->name, publisher_id ) < 0)
+        return FALSE;
+    return TRUE;
+}
+
+/* Finds a package by full name in Wine's staged package graph: the caller's catalog-registered
+ * package and the packages staged beside it. Packages from other publishers are not matched
+ * because publisher id derivation is not implemented. */
+static LONG find_staged_package( const WCHAR *full_name, struct package_node *out )
+{
+    WCHAR current[PACKAGE_FULL_NAME_MAX_LENGTH + 1], name[PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+    WCHAR repository[MAX_PATH], pattern[MAX_PATH], root[MAX_PATH], *slash;
+    BYTE basic[sizeof(PACKAGE_ID) + sizeof(current)];
+    UINT32 length = ARRAY_SIZE(current), basic_len = sizeof(basic);
+    PACKAGE_ID *head_id = (PACKAGE_ID *)basic;
+    struct package_resources *res;
+    struct package_node head;
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+    LONG ret = ERROR_NOT_FOUND;
+
+    if (get_current_package_identity_string( 0, &length, current ) ||
+        PackageIdFromFullName( current, 0, &basic_len, basic ) ||
+        get_current_package_resources( &res )) return ERROR_NOT_FOUND;
+    if (!wcsicmp( full_name, current )) return read_package_node( res->root, out, NULL, NULL );
+    if (read_package_node( res->root, &head, NULL, NULL )) return ERROR_NOT_FOUND;
+
+    wcscpy( repository, res->root );
+    if (!(slash = wcsrchr( repository, '\\' )) || slash - repository + 3 > ARRAY_SIZE(pattern)) return ERROR_NOT_FOUND;
+    *slash = 0;
+    wcscpy( pattern, repository );
+    wcscat( pattern, L"\\*" );
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return ERROR_NOT_FOUND;
+    do
+    {
+        if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+        if (wcslen( repository ) + 1 + wcslen( data.cFileName ) >= ARRAY_SIZE(root)) continue;
+        wcscpy( root, repository );
+        wcscat( root, L"\\" );
+        wcscat( root, data.cFileName );
+        if (read_package_node( root, out, NULL, NULL ) || wcscmp( out->publisher, head.publisher )) continue;
+        if (!format_package_names( out, head_id->publisherId, name, NULL ) || wcsicmp( name, full_name )) continue;
+        ret = ERROR_SUCCESS;
+        break;
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+    return ret;
+}
+
+/***********************************************************************
+ *         FindPackagesByPackageFamily   (kernelbase.@)
+ *
+ * Measured on Windows 11 26100 (in and out of package context): PACKAGE_FILTER_HEAD returns the
+ * main package, PACKAGE_FILTER_DIRECT the framework packages (PACKAGE_PROPERTY_FRAMEWORK); the
+ * family is matched case-insensitively and an unknown family or a full name yields count 0. A
+ * filter without HEAD/DIRECT/RESOURCE/BUNDLE, a NULL family/count/length or a family without a
+ * '_' separator fail with ERROR_INVALID_PARAMETER and an empty family with ERROR_MORE_DATA,
+ * leaving the outputs untouched. A short buffer fails with ERROR_INSUFFICIENT_BUFFER and reports
+ * the required count and length; a NULL name array with a sufficient buffer succeeds.
+ */
+LONG WINAPI FindPackagesByPackageFamily( const WCHAR *family_name, UINT32 filters, UINT32 *count,
+                                         WCHAR **full_names, UINT32 *buffer_len, WCHAR *buffer,
+                                         UINT32 *properties )
+{
+    WCHAR (*names)[PACKAGE_FULL_NAME_MAX_LENGTH + 1] = NULL;
+    UINT32 *props = NULL, capacity = 0;
+    LONG ret = ERROR_SUCCESS;
+    WCHAR current[PACKAGE_FULL_NAME_MAX_LENGTH + 1], family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    WCHAR repository[MAX_PATH], pattern[MAX_PATH], root[MAX_PATH], *slash;
+    BYTE basic[sizeof(PACKAGE_ID) + sizeof(current)];
+    UINT32 length = ARRAY_SIZE(current), basic_len = sizeof(basic), found = 0, needed = 0, i;
+    PACKAGE_ID *head_id = (PACKAGE_ID *)basic;
+    struct package_resources *res;
+    struct package_node head, node;
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+
+    TRACE( "(%s %#x %p %p %p %p %p)\n", debugstr_w(family_name), filters, count, full_names,
+           buffer_len, buffer, properties );
+
+    if (!family_name || !count || !buffer_len) return ERROR_INVALID_PARAMETER;
+    if (!(filters & (PACKAGE_FILTER_HEAD | PACKAGE_FILTER_DIRECT | PACKAGE_FILTER_RESOURCE | PACKAGE_FILTER_BUNDLE)))
+        return ERROR_INVALID_PARAMETER;
+    if (!family_name[0]) return ERROR_MORE_DATA;
+    if (!wcschr( family_name, '_' )) return ERROR_INVALID_PARAMETER;
+    if (filters & (PACKAGE_FILTER_RESOURCE | PACKAGE_FILTER_BUNDLE))
+        FIXME( "resource and bundle packages are not staged, filters %#x\n", filters );
+
+    if (!get_current_package_identity_string( 0, &length, current ) &&
+        !PackageIdFromFullName( current, 0, &basic_len, basic ) &&
+        !get_current_package_resources( &res ) && !read_package_node( res->root, &head, NULL, NULL ) &&
+        (slash = wcsrchr( wcscpy( repository, res->root ), '\\' )) && slash - repository + 3 <= ARRAY_SIZE(pattern))
+    {
+        *slash = 0;
+        wcscpy( pattern, repository );
+        wcscat( pattern, L"\\*" );
+        if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || data.cFileName[0] == '.') continue;
+                if (wcslen( repository ) + 1 + wcslen( data.cFileName ) >= ARRAY_SIZE(root)) continue;
+                wcscpy( root, repository );
+                wcscat( root, L"\\" );
+                wcscat( root, data.cFileName );
+                if (read_package_node( root, &node, NULL, NULL ) || wcscmp( node.publisher, head.publisher )) continue;
+                if (!(filters & (node.framework ? PACKAGE_FILTER_DIRECT : PACKAGE_FILTER_HEAD))) continue;
+                if (found == capacity)
+                {
+                    UINT32 grow = capacity ? capacity * 2 : 8;
+                    void *ptr;
+
+                    ptr = names ? HeapReAlloc( GetProcessHeap(), 0, names, grow * sizeof(*names) )
+                                : HeapAlloc( GetProcessHeap(), 0, grow * sizeof(*names) );
+                    if (!ptr) { ret = ERROR_NOT_ENOUGH_MEMORY; break; }
+                    names = ptr;
+                    ptr = props ? HeapReAlloc( GetProcessHeap(), 0, props, grow * sizeof(*props) )
+                                : HeapAlloc( GetProcessHeap(), 0, grow * sizeof(*props) );
+                    if (!ptr) { ret = ERROR_NOT_ENOUGH_MEMORY; break; }
+                    props = ptr;
+                    capacity = grow;
+                }
+                if (!format_package_names( &node, head_id->publisherId, names[found], family )) continue;
+                if (wcsicmp( family, family_name )) continue;
+                props[found] = node.framework ? PACKAGE_PROPERTY_FRAMEWORK : 0;
+                needed += wcslen( names[found] ) + 1;
+                found++;
+            } while (FindNextFileW( find, &data ));
+            FindClose( find );
+        }
+    }
+    else FIXME( "no staged package graph outside package context\n" );
+
+    if (ret) goto done;
+    if (*buffer_len < needed || (full_names && *count < found))
+    {
+        *count = found;
+        *buffer_len = needed;
+        ret = ERROR_INSUFFICIENT_BUFFER;
+        goto done;
+    }
+    for (i = 0, length = 0; i < found; i++)
+    {
+        if (buffer) wcscpy( buffer + length, names[i] );
+        if (full_names) full_names[i] = buffer ? buffer + length : NULL;
+        if (properties) properties[i] = props[i];
+        length += wcslen( names[i] ) + 1;
+    }
+    *count = found;
+    *buffer_len = needed;
+done:
+    HeapFree( GetProcessHeap(), 0, names );
+    HeapFree( GetProcessHeap(), 0, props );
+    return ret;
+}
+
+/***********************************************************************
+ *         AppXGetOSMaxVersionTested   (kernelbase.@)
+ *
+ * Private; HRESULT (PCWSTR full_name, UINT64 *version) per MrmCoreR call sites. Measured on
+ * Windows 11 26100 in and out of package context: returns TargetDeviceFamily MaxVersionTested
+ * as a PACKAGE_VERSION value for any installed full name; unknown or malformed names fail with
+ * HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), an empty name with HRESULT_FROM_WIN32(ERROR_MORE_DATA),
+ * NULL arguments with E_INVALIDARG. The output is untouched on failure.
+ */
+HRESULT WINAPI AppXGetOSMaxVersionTested( const WCHAR *full_name, UINT64 *version )
+{
+    struct package_node node;
+
+    TRACE( "(%s %p)\n", debugstr_w(full_name), version );
+
+    if (!full_name || !version) return E_INVALIDARG;
+    if (!full_name[0]) return HRESULT_FROM_WIN32( ERROR_MORE_DATA );
+    if (find_staged_package( full_name, &node )) return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+    if (!node.has_max_tested)
+    {
+        FIXME( "%s has no TargetDeviceFamily MaxVersionTested\n", debugstr_w(full_name) );
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    *version = node.max_tested.Version;
+    return S_OK;
+}
+
+/***********************************************************************
+ *         GetStagedPackagePathByFullName   (kernelbase.@)
+ *
+ * Native kernelbase performs the same argument checks and internal lookup as
+ * GetStagedPackagePathByFullName2 with PackagePathType_Install.
+ */
+LONG WINAPI GetStagedPackagePathByFullName( const WCHAR *full_name, UINT32 *length, WCHAR *path )
+{
+    TRACE( "(%s %p %p)\n", debugstr_w(full_name), length, path );
+    return GetStagedPackagePathByFullName2( full_name, PackagePathType_Install, length, path );
+}
+
+/***********************************************************************
+ *         GetStagedPackagePathByFullName2   (kernelbase.@)
+ */
+LONG WINAPI GetStagedPackagePathByFullName2( const WCHAR *full_name, PackagePathType type,
+                                             UINT32 *length, WCHAR *path )
+{
+    struct package_node node;
+    UINT32 id_size = 0, needed;
+    LONG ret;
+
+    TRACE( "(%s %d %p %p)\n", debugstr_w(full_name), type, length, path );
+
+    if (!full_name || !length || (*length && !path)) return ERROR_INVALID_PARAMETER;
+    if ((UINT32)type > 5) return ERROR_INVALID_PARAMETER;
+    if (!full_name[0]) return ERROR_MORE_DATA;
+    ret = PackageIdFromFullName( full_name, 0, &id_size, NULL );
+    if (ret != ERROR_INSUFFICIENT_BUFFER) return ERROR_INVALID_PARAMETER;
+    if (find_staged_package( full_name, &node )) return ERROR_NOT_FOUND;
+
+    switch (type)
+    {
+    case PackagePathType_Install:
+    case PackagePathType_Effective:
+        break;
+    case PackagePathType_Mutable:
+        /* Staged packages here never declare a mutable location. */
+        return APPMODEL_ERROR_NO_MUTABLE_DIRECTORY;
+    default:
+        /* Machine/User/Effective external locations are not modelled. */
+        return ERROR_NOT_FOUND;
+    }
+
+    needed = wcslen( node.root ) + 1;
+    if (*length < needed)
+    {
+        *length = needed;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memcpy( path, node.root, needed * sizeof(WCHAR) );
+    *length = needed;
+    return ERROR_SUCCESS;
+}
+static BOOL is_package_name_char( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-';
+}
+
+/* publisher ids are 13 characters of Crockford base32 */
+static BOOL is_publisher_id_char( WCHAR c )
+{
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z' && c != 'i' && c != 'l' && c != 'o' && c != 'u');
+}
+
+static BOOL is_relative_app_id_char( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.';
+}
+
+/***********************************************************************
+ *         ParseApplicationUserModelId   (kernelbase.@)
+ */
+LONG WINAPI ParseApplicationUserModelId( const WCHAR *aumid, UINT32 *family_length, WCHAR *family_name,
+                                         UINT32 *app_id_length, WCHAR *app_id )
+{
+    const WCHAR *bang, *underscore, *p;
+    UINT32 family_needed, app_needed;
+
+    TRACE( "(%s %p %p %p %p)\n", debugstr_w(aumid), family_length, family_name, app_id_length, app_id );
+
+    if (!aumid || !family_length || !app_id_length) return ERROR_INVALID_PARAMETER;
+    if (!(bang = wcschr( aumid, '!' ))) return ERROR_INVALID_PARAMETER;
+    if (!(underscore = wcschr( aumid, '_' )) || underscore > bang) return ERROR_INVALID_PARAMETER;
+    if (underscore - aumid < 3 || underscore - aumid > 50) return ERROR_INVALID_PARAMETER;
+    for (p = aumid; p < underscore; p++) if (!is_package_name_char( *p )) return ERROR_INVALID_PARAMETER;
+    if (bang - underscore - 1 != 13) return ERROR_INVALID_PARAMETER;
+    for (p = underscore + 1; p < bang; p++) if (!is_publisher_id_char( *p )) return ERROR_INVALID_PARAMETER;
+    if (!bang[1] || wcslen( bang + 1 ) > 64) return ERROR_INVALID_PARAMETER;
+    for (p = bang + 1; *p; p++) if (!is_relative_app_id_char( *p )) return ERROR_INVALID_PARAMETER;
+
+    family_needed = bang - aumid + 1;
+    app_needed = wcslen( bang + 1 ) + 1;
+    if (*family_length < family_needed || *app_id_length < app_needed || !family_name || !app_id)
+    {
+        *family_length = family_needed;
+        *app_id_length = app_needed;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memcpy( family_name, aumid, (family_needed - 1) * sizeof(WCHAR) );
+    family_name[family_needed - 1] = 0;
+    memcpy( app_id, bang + 1, app_needed * sizeof(WCHAR) );
+    *family_length = family_needed;
+    *app_id_length = app_needed;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         PackageFamilyNameFromFullName   (kernelbase.@)
+ */
+LONG WINAPI PackageFamilyNameFromFullName( const WCHAR *full_name, UINT32 *length, WCHAR *family_name )
+{
+    UINT32 size = 0, needed;
+    PACKAGE_ID *id;
+    LONG ret;
+
+    TRACE( "(%s %p %p)\n", debugstr_w(full_name), length, family_name );
+
+    if (!full_name || !length || (*length && !family_name)) return ERROR_INVALID_PARAMETER;
+
+    if ((ret = PackageIdFromFullName( full_name, 0, &size, NULL )) != ERROR_INSUFFICIENT_BUFFER)
+        return ret ? ret : ERROR_INVALID_PARAMETER;
+    if (!(id = HeapAlloc( GetProcessHeap(), 0, size ))) return ERROR_OUTOFMEMORY;
+    if ((ret = PackageIdFromFullName( full_name, 0, &size, (BYTE *)id )))
+    {
+        HeapFree( GetProcessHeap(), 0, id );
+        return ret;
+    }
+
+    /* "~" is only valid as the whole resource id of a neutral bundle. */
+    if (id->resourceId && wcschr( id->resourceId, L'~' )
+            && (wcscmp( id->resourceId, L"~" ) || id->processorArchitecture != PROCESSOR_ARCHITECTURE_NEUTRAL))
+    {
+        HeapFree( GetProcessHeap(), 0, id );
+        return ERROR_INVALID_PARAMETER;
+    }
+
+    needed = wcslen( id->name ) + 1 + wcslen( id->publisherId ) + 1;
+    if (*length < needed)
+    {
+        *length = needed;
+        HeapFree( GetProcessHeap(), 0, id );
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    swprintf( family_name, needed, L"%s_%s", id->name, id->publisherId );
+    *length = needed;
+    HeapFree( GetProcessHeap(), 0, id );
+    return ERROR_SUCCESS;
+}
+/* Globalization contexts: one per Application element of the main package manifest, in
+ * manifest order. Measured on Windows 11 26100 for Microsoft.GamingApp (Applications
+ * Microsoft.Xbox.App, Microsoft.Xbox.AppL, Microsoft.Xbox.WidgetsApp): kind 0 selects the
+ * current application (case-insensitive id match), any other kind is an index into the list,
+ * out-of-range or unresolved selections fail with ERROR_NOT_FOUND and flags are ignored.
+ * Properties 1 and 2 report bits 0 and 1 of per-application flags as a BOOL. Every Xbox app
+ * entry reports 0 natively; Wine does not know a manifest source that sets these bits. */
+#define MAX_PACKAGE_APPLICATIONS 64
+
+struct package_globalization_context
+{
+    WCHAR id[256];
+    DWORD flags;
+};
+
+struct package_globalization_list
+{
+    UINT32 count;
+    struct package_globalization_context apps[MAX_PACKAGE_APPLICATIONS];
+};
+
+static struct package_globalization_list *current_globalization_list;
+
+static LONG read_package_applications( const WCHAR *root, struct package_globalization_list *list )
+{
+    struct { const WCHAR *name; int len; } stack[8];
+    struct manifest_tag tag;
+    const WCHAR *end, *p;
+    WCHAR path[MAX_PATH], *data;
+    unsigned int depth = 0;
+    LONG ret = ERROR_BAD_FORMAT;
+
+    list->count = 0;
+    if (wcslen( root ) + ARRAY_SIZE(L"\\AppxManifest.xml") > ARRAY_SIZE(path)) return ERROR_NOT_FOUND;
+    wcscpy( path, root );
+    wcscat( path, L"\\AppxManifest.xml" );
+    if (!(data = read_manifest( path, &end ))) return ERROR_NOT_FOUND;
+    p = data;
+    while (manifest_next_tag( p, end, &tag ))
+    {
+        p = tag.next;
+        if (tag.closing)
+        {
+            if (!depth) goto done;
+            depth--;
+            continue;
+        }
+        if (!depth && !manifest_local_name_is( tag.name, tag.name_len, L"Package" )) goto done;
+        if (depth == 2 && manifest_local_name_is( stack[1].name, stack[1].len, L"Applications" ) &&
+            manifest_local_name_is( tag.name, tag.name_len, L"Application" ))
+        {
+            if (list->count >= MAX_PACKAGE_APPLICATIONS) { ret = ERROR_NOT_SUPPORTED; goto done; }
+            if (!copy_manifest_attribute( &tag, L"Id", list->apps[list->count].id,
+                                          ARRAY_SIZE(list->apps[list->count].id) )) goto done;
+            list->apps[list->count++].flags = 0;
+        }
+        if (!tag.empty)
+        {
+            if (depth >= 64) goto done;
+            if (depth < ARRAY_SIZE(stack))
+            {
+                stack[depth].name = tag.name;
+                stack[depth].len = tag.name_len;
+            }
+            depth++;
+        }
+    }
+    ret = ERROR_SUCCESS;
+done:
+    if (ret == ERROR_BAD_FORMAT) WARN( "Malformed package manifest %s\n", debugstr_w(path) );
+    HeapFree( GetProcessHeap(), 0, data );
+    return ret;
+}
+
+static LONG get_package_globalization_list( struct package_globalization_list **out )
+{
+    struct package_globalization_list *list;
+    struct package_resources *res;
+    LONG ret;
+
+    if ((list = ReadPointerAcquire( (void **)&current_globalization_list ))) goto done;
+    if ((ret = get_current_package_resources( &res ))) return ret;
+    if (!(list = HeapAlloc( GetProcessHeap(), 0, sizeof(*list) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((ret = read_package_applications( res->root, list )))
+    {
+        HeapFree( GetProcessHeap(), 0, list );
+        return ret;
+    }
+    if (InterlockedCompareExchangePointer( (void **)&current_globalization_list, list, NULL ))
+    {
+        HeapFree( GetProcessHeap(), 0, list );
+        list = current_globalization_list;
+    }
+done:
+    *out = list;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         GetCurrentPackageGlobalizationContext   (kernelbase.@)
+ */
+LONG WINAPI GetCurrentPackageGlobalizationContext( UINT32 kind, UINT32 flags,
+                                                   PACKAGE_GLOBALIZATION_CONTEXT_REFERENCE *context )
+{
+    WCHAR full_name[PACKAGE_FULL_NAME_MAX_LENGTH + 1], app_id[256];
+    UINT32 len = ARRAY_SIZE(full_name), index;
+    struct package_globalization_list *list;
+    LONG ret;
+
+    TRACE( "(%u %#x %p)\n", kind, flags, context );
+
+    if (!context) return ERROR_INVALID_PARAMETER;
+    if ((ret = get_current_package_identity_string( 0, &len, full_name ))) return ret;
+    if (get_package_globalization_list( &list )) return ERROR_NOT_FOUND;
+    if (kind)
+        index = kind;
+    else
+    {
+        len = ARRAY_SIZE(app_id);
+        if (get_current_package_identity_string( 1, &len, app_id )) return ERROR_NOT_FOUND;
+        for (index = 0; index < list->count; index++)
+            if (!wcsicmp( list->apps[index].id, app_id )) break;
+    }
+    if (index >= list->count) return ERROR_NOT_FOUND;
+    *context = (PACKAGE_GLOBALIZATION_CONTEXT_REFERENCE)&list->apps[index];
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         GetPackageGlobalizationProperty   (kernelbase.@)
+ */
+LONG WINAPI GetPackageGlobalizationProperty( PACKAGE_GLOBALIZATION_CONTEXT_REFERENCE context, UINT32 property,
+                                             UINT32 *size, BYTE *buffer )
+{
+    const struct package_globalization_context *app = (const struct package_globalization_context *)context;
+    BOOL value;
+
+    TRACE( "(%p %u %p %p)\n", context, property, size, buffer );
+
+    if (!app || !size || (*size && !buffer)) return ERROR_INVALID_PARAMETER;
+    if (property == 1) value = !!(app->flags & 1);
+    else if (property == 2) value = !!(app->flags & 2);
+    else return ERROR_INVALID_PARAMETER;
+    if (*size < sizeof(value))
+    {
+        *size = sizeof(value);
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memset( buffer, 0, *size );
+    memcpy( buffer, &value, sizeof(value) );
+    *size = sizeof(value);
+    return ERROR_SUCCESS;
+}
+static WCHAR *put_package_string( BYTE **cursor, const WCHAR *s )
+{
+    SIZE_T bytes = (wcslen( s ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = (WCHAR *)*cursor;
+
+    memcpy( ret, s, bytes );
+    *cursor += bytes;
+    return ret;
+}
+
+/***********************************************************************
+ *         GetCurrentPackageInfo2   (kernelbase.@)
+ *
+ * Measured on Windows 11 26100 for Microsoft.GamingApp with four framework dependencies:
+ * the PACKAGE_INFO array is followed, per package and without padding, by path, name,
+ * publisherId, publisher, full name and family name; an empty resourceId is NULL. The head has
+ * flags 0x10, static framework dependencies 0x21. Filter 0, HEAD, DIRECT or STATIC select
+ * packages; other filters succeed with an empty result. Install and Effective paths are the
+ * install directory; Mutable fails with APPMODEL_ERROR_NO_MUTABLE_DIRECTORY. A short buffer
+ * fails with ERROR_INSUFFICIENT_BUFFER after setting the length and count.
+ */
+LONG WINAPI GetCurrentPackageInfo2( const UINT32 flags, PackagePathType type, UINT32 *buffer_length,
+                                    BYTE *buffer, UINT32 *count )
+{
+    struct package_graph
+    {
+        struct package_node nodes[MAX_PACKAGE_DEPENDENCIES + 1];
+        struct package_dependency deps[MAX_PACKAGE_DEPENDENCIES];
+        WCHAR full[MAX_PACKAGE_DEPENDENCIES + 1][PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+        WCHAR family[MAX_PACKAGE_DEPENDENCIES + 1][PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    } *graph;
+    WCHAR full_name[PACKAGE_FULL_NAME_MAX_LENGTH + 1], repository[MAX_PATH], *slash;
+    BYTE basic[sizeof(PACKAGE_ID) + sizeof(full_name)];
+    UINT32 name_len = ARRAY_SIZE(full_name), basic_len = sizeof(basic), size, available, first, last, i;
+    PACKAGE_ID *head_id = (PACKAGE_ID *)basic;
+    struct package_resources *res;
+    unsigned int dep_count = 0;
+    PACKAGE_INFO *info;
+    BOOL head, direct;
+    BYTE *cursor;
+    LONG ret;
+
+    TRACE( "(%#x %d %p %p %p)\n", flags, type, buffer_length, buffer, count );
+
+    if (!buffer_length || !count || (*buffer_length && !buffer)) return ERROR_INVALID_PARAMETER;
+    if (type != PackagePathType_Install && type != PackagePathType_Mutable && type != PackagePathType_Effective)
+        return ERROR_INVALID_PARAMETER;
+    if ((ret = get_current_package_identity_string( 0, &name_len, full_name ))) return ret;
+    if ((ret = PackageIdFromFullName( full_name, 0, &basic_len, basic ))) return ret;
+    if ((ret = get_current_package_resources( &res ))) return ret;
+
+    head = !flags || (flags & (PACKAGE_FILTER_HEAD | PACKAGE_FILTER_STATIC));
+    direct = !flags || (flags & (PACKAGE_FILTER_DIRECT | PACKAGE_FILTER_STATIC));
+    if (!(graph = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*graph) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if ((ret = read_package_node( res->root, &graph->nodes[0], graph->deps, &dep_count ))) goto done;
+    wcscpy( graph->full[0], full_name );
+    if (wcslen( graph->nodes[0].name ) + 1 + wcslen( head_id->publisherId ) >= ARRAY_SIZE(graph->family[0]))
+    {
+        ret = ERROR_INVALID_DATA;
+        goto done;
+    }
+    wcscpy( graph->family[0], graph->nodes[0].name );
+    wcscat( graph->family[0], L"_" );
+    wcscat( graph->family[0], head_id->publisherId );
+
+    if (!direct) dep_count = 0;
+    if (dep_count)
+    {
+        wcscpy( repository, res->root );
+        if (!(slash = wcsrchr( repository, '\\' )))
+        {
+            ret = APPMODEL_ERROR_PACKAGE_NOT_AVAILABLE;
+            goto done;
+        }
+        *slash = 0;
+    }
+    for (i = 0; i < dep_count; i++)
+    {
+        struct package_node *node = &graph->nodes[i + 1];
+
+        if (wcscmp( graph->deps[i].publisher, graph->nodes[0].publisher ))
+        {
+            FIXME( "Dependency %s has a different publisher; publisher id derivation is not implemented\n",
+                   debugstr_w(graph->deps[i].name) );
+            ret = ERROR_NOT_SUPPORTED;
+            goto done;
+        }
+        if ((ret = resolve_package_dependency( repository, &graph->nodes[0], &graph->deps[i], node )))
+        {
+            WARN( "Dependency %s of %s is not staged\n", debugstr_w(graph->deps[i].name), debugstr_w(full_name) );
+            goto done;
+        }
+        if (!format_package_names( node, head_id->publisherId, graph->full[i + 1], graph->family[i + 1] ))
+        {
+            ret = ERROR_INVALID_DATA;
+            goto done;
+        }
+    }
+
+    first = head ? 0 : 1;
+    last = dep_count + 1;
+    if (first >= last)
+    {
+        *buffer_length = 0;
+        *count = 0;
+        ret = ERROR_SUCCESS;
+        goto done;
+    }
+    if (type == PackagePathType_Mutable)
+    {
+        ret = APPMODEL_ERROR_NO_MUTABLE_DIRECTORY;
+        goto done;
+    }
+
+    size = (last - first) * sizeof(PACKAGE_INFO);
+    for (i = first; i < last; i++)
+    {
+        size += (wcslen( graph->nodes[i].root ) + 1 + wcslen( graph->nodes[i].name ) + 1 +
+                 wcslen( head_id->publisherId ) + 1 + wcslen( graph->nodes[i].publisher ) + 1 +
+                 wcslen( graph->full[i] ) + 1 + wcslen( graph->family[i] ) + 1) * sizeof(WCHAR);
+        if (!i && head_id->resourceId && head_id->resourceId[0])
+            size += (wcslen( head_id->resourceId ) + 1) * sizeof(WCHAR);
+    }
+    available = *buffer_length;
+    *buffer_length = size;
+    *count = last - first;
+    if (available < size)
+    {
+        ret = ERROR_INSUFFICIENT_BUFFER;
+        goto done;
+    }
+
+    info = (PACKAGE_INFO *)buffer;
+    memset( info, 0, (last - first) * sizeof(PACKAGE_INFO) );
+    cursor = buffer + (last - first) * sizeof(PACKAGE_INFO);
+    for (i = first; i < last; i++, info++)
+    {
+        const struct package_node *node = &graph->nodes[i];
+
+        info->flags = (i ? PACKAGE_FILTER_DIRECT : PACKAGE_FILTER_HEAD) |
+                      (node->framework ? PACKAGE_PROPERTY_FRAMEWORK : 0);
+        info->packageId.processorArchitecture = i ? processor_arch_from_string( node->arch, wcslen( node->arch ) )
+                                                  : head_id->processorArchitecture;
+        info->packageId.version = node->version;
+        info->path = put_package_string( &cursor, node->root );
+        info->packageId.name = put_package_string( &cursor, node->name );
+        if (!i && head_id->resourceId && head_id->resourceId[0])
+            info->packageId.resourceId = put_package_string( &cursor, head_id->resourceId );
+        info->packageId.publisherId = put_package_string( &cursor, head_id->publisherId );
+        info->packageId.publisher = put_package_string( &cursor, node->publisher );
+        info->packageFullName = put_package_string( &cursor, graph->full[i] );
+        info->packageFamilyName = put_package_string( &cursor, graph->family[i] );
+    }
+    ret = ERROR_SUCCESS;
+done:
+    HeapFree( GetProcessHeap(), 0, graph );
+    return ret;
+}
+
+/***********************************************************************
+ *         GetCurrentPackageInfo3   (kernelbase.@)
+ *
+ * Measured on Windows 11 26100. PackageInfoGeneration (16) needs no package: it reports the
+ * dynamic dependency generation as a UINT32 (0 without dynamic dependencies), sets *length to 4
+ * and *count to 0; a length below 4 fails with HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER)
+ * without updating it. Other types require package identity (HRESULT_FROM_WIN32(NO_PACKAGE)
+ * otherwise). Types 0-2 are GetCurrentPackageInfo2 path types with HRESULT results; type 17
+ * lists dynamic dependencies and is empty for every filter in a static package graph; the
+ * remaining types fail with E_INVALIDARG. Wine has no dynamic package dependency APIs.
+ */
+HRESULT WINAPI GetCurrentPackageInfo3( UINT32 flags, PackageInfo3Type type, UINT32 *length, void *buffer,
+                                       UINT32 *count )
+{
+    WCHAR name[PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+    UINT32 name_len = ARRAY_SIZE(name);
+    UINT32 scratch_count;
+    LONG ret;
+
+    TRACE( "(%#x %d %p %p %p)\n", flags, type, length, buffer, count );
+
+    if (type == PackageInfo3Type_PackageInfoGeneration)
+    {
+        if (!length || (*length && !buffer)) return E_INVALIDARG;
+        if (count) *count = 0;
+        if (*length < sizeof(UINT32)) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        *(UINT32 *)buffer = 0;
+        *length = sizeof(UINT32);
+        return S_OK;
+    }
+    if ((ret = get_current_package_identity_string( 0, &name_len, name ))) return HRESULT_FROM_WIN32( ret );
+    switch ((UINT32)type)
+    {
+    case PackagePathType_Install:
+    case PackagePathType_Mutable:
+    case PackagePathType_Effective:
+        /* Native accepts a NULL count only for a sizing call (*length == 0). */
+        if (!length || (*length && (!buffer || !count))) return E_INVALIDARG;
+        return HRESULT_FROM_WIN32( GetCurrentPackageInfo2( flags, (PackagePathType)type, length, buffer,
+                                                           count ? count : &scratch_count ) );
+    case 17:
+        if (!length || (*length && (!buffer || !count))) return E_INVALIDARG;
+        *length = 0;
+        if (count) *count = 0;
+        return S_OK;
+    default:
+        return E_INVALIDARG;
+    }
+}
