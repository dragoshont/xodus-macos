+/***********************************************************************
+ *		CreateWindowInBandEx (USER32.@)
+ *
+ * Wine does not model z-order bands; only the default and desktop bands,
+ * which are the ones an ordinary process may use, are supported.
+ */
+HWND WINAPI CreateWindowInBandEx( DWORD exStyle, LPCWSTR className, LPCWSTR windowName, DWORD style,
+                                  INT x, INT y, INT width, INT height, HWND parent, HMENU menu,
+                                  HINSTANCE instance, LPVOID data, DWORD band, DWORD type )
+{
+    TRACE( "band %lu type %#lx class %s\n", band, type, debugstr_w(IS_INTRESOURCE(className) ? NULL : className) );
+
+    if (type & ~7)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    /* Native denies type 1 (core window) to unpackaged desktop processes; the
+     * packaged Windows.UI CoreWindow path relies on it, so key it on package identity. */
+    if (type == 1)
+    {
+        UINT32 len = 0;
+        if (GetCurrentPackageFullName( &len, NULL ) != ERROR_INSUFFICIENT_BUFFER)
+        {
+            SetLastError( ERROR_ACCESS_DENIED );
+            return 0;
+        }
+    }
+    else if (type && type != 4)
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return 0;
+    }
+    if (band == 15 /* ZBID_IMMERSIVE_INACTIVEDOCK */)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    if (band > 1 /* ZBID_DESKTOP */)
+    {
+        FIXME( "band %lu not supported\n", band );
+        SetLastError( ERROR_ACCESS_DENIED );
+        return 0;
+    }
+    if (type) FIXME( "ignoring type %#lx\n", type );
+    return CreateWindowExW( exStyle, className, windowName, style, x, y, width, height,
+                            parent, menu, instance, data );
+}
