+DWORD WINAPI NtUserGetQueueStatusReadonly( UINT flags )
+{
+    UINT ret, wake_bits, changed_bits;
+
+    check_for_events( flags );
+
+    if (get_shared_queue_bits( &wake_bits, &changed_bits ))
+        ret = MAKELONG( changed_bits & flags, wake_bits & flags );
+    else SERVER_START_REQ( get_queue_status )
+    {
+        req->clear_bits = 0;
+        wine_server_call( req );
+        ret = MAKELONG( reply->changed_bits & flags, reply->wake_bits & flags );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
