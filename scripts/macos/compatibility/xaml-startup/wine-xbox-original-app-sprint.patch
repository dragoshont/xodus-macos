+struct package_node
+{
+    WCHAR root[MAX_PATH];
+    WCHAR name[PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+    WCHAR publisher[512];
+    WCHAR arch[16];
+    PACKAGE_VERSION version;
