+/* WIN://PKG holds the registration origin in its high 32 bits (see server/package_activation.c). */
+static LONG get_current_package_origin( UINT32 *origin )
+{
+    struct package_attribute
+    {
+        UNICODE_STRING name;
+        USHORT type, reserved;
+        ULONG flags, count;
+        union { ULONGLONG *integers; void *pointer; } values;
+    };
+    struct package_attributes
+    {
+        USHORT version, reserved;
+        ULONG count;
+        struct package_attribute *attributes;
+    } *info;
+    UNICODE_STRING attribute_name;
+    struct package_attribute *attribute;
+    ULONG_PTR base, end, address;
+    ULONG bytes = 0, allocated;
+    NTSTATUS status;
+    HANDLE token;
+    LONG result = ERROR_INVALID_DATA;
+
+    if ((status = NtOpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token )))
+        return RtlNtStatusToDosError( status );
+    RtlInitUnicodeString( &attribute_name, L"WIN://PKG" );
+    status = NtQuerySecurityAttributesToken( token, &attribute_name, 1, NULL, 0, &bytes );
+    if (status != STATUS_BUFFER_TOO_SMALL || bytes < sizeof(*info) || bytes > 64 * 1024)
+    {
+        NtClose( token );
+        return status == STATUS_NOT_FOUND ? APPMODEL_ERROR_NO_PACKAGE : ERROR_INVALID_DATA;
+    }
+    allocated = bytes;
+    if (!(info = HeapAlloc( GetProcessHeap(), 0, allocated )))
+    {
+        NtClose( token );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    status = NtQuerySecurityAttributesToken( token, &attribute_name, 1, info, allocated, &bytes );
+    NtClose( token );
+    if (status)
+    {
+        HeapFree( GetProcessHeap(), 0, info );
+        return status == STATUS_NOT_FOUND ? APPMODEL_ERROR_NO_PACKAGE : RtlNtStatusToDosError( status );
+    }
+    base = (ULONG_PTR)info;
+    end = base + allocated;
+    address = (ULONG_PTR)info->attributes;
+    if (info->version != 1 || info->count != 1 ||
+        address < base || address > end || sizeof(*attribute) > end - address)
+        goto done;
+    attribute = info->attributes;
+    address = (ULONG_PTR)attribute->values.integers;
+    if (attribute->type != 2 || attribute->count != 1 ||
+        address < base || address > end || sizeof(ULONGLONG) > end - address)
+        goto done;
+    *origin = attribute->values.integers[0] >> 32;
+    result = ERROR_SUCCESS;
+done:
+    if (result) WARN( "Malformed package origin token attribute\n" );
+    HeapFree( GetProcessHeap(), 0, info );
+    return result;
+}
+
+/***********************************************************************
+ *         GetStagedPackageOrigin   (kernelbase.@)
+ */
+LONG WINAPI GetStagedPackageOrigin( const WCHAR *full_name, UINT32 *origin )
+{
+    WCHAR current[PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+    UINT32 length = ARRAY_SIZE(current), value = 0;
+    LONG result;
+
+    TRACE( "(%s %p)\n", debugstr_w(full_name), origin );
+
+    if (!full_name || !origin) return ERROR_INVALID_PARAMETER;
+    if (!full_name[0])
+    {
+        SetLastError( ERROR_SUCCESS );
+        return ERROR_MORE_DATA;
+    }
+    /* Only the caller's catalog-registered package is staged in Wine's package graph. */
+    if (get_current_package_identity_string( 0, &length, current ) || wcsicmp( current, full_name ))
+    {
+        SetLastError( ERROR_SUCCESS );
+        return ERROR_APP_DATA_NOT_FOUND;
+    }
+    if ((result = get_current_package_origin( &value ))) return result;
+    *origin = value;
+    return ERROR_SUCCESS;
+}
