 /***********************************************************************
+ *		SetWindowFeedbackSetting (USER32.@)
+ */
+BOOL WINAPI SetWindowFeedbackSetting( HWND hwnd, FEEDBACK_TYPE type, DWORD flags, UINT32 size, const void *config )
+{
+    struct window_feedback_params params = { .type = type };
+
+    TRACE( "%p %u %#lx %u %p\n", hwnd, type, flags, size, config );
+
+    if (type < FEEDBACK_TOUCH_CONTACTVISUALIZATION || type > FEEDBACK_MAX_MEASURED || flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!size) params.reset = TRUE;
+    else if (size != sizeof(BOOL) || !config)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    else params.value = *(const BOOL *)config != 0;
+    return NtUserCallHwndParam( hwnd, (UINT_PTR)&params, NtUserCallHwndParam_SetWindowFeedbackSetting );
+}
