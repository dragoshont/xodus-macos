+/* The publisher display name is not part of the package full name; take it from the
+ * installed package manifest and accept it only if it matches the token identity. */
+static HRESULT manifest_publisher( const PACKAGE_ID *id, HSTRING *value )
+{
+    WCHAR path[MAX_PATH], version[64], publisher_id[14], *text = NULL, *element, *end;
+    WCHAR *name = NULL, *manifest_version = NULL, *arch = NULL, *publisher = NULL;
+    const WCHAR *expected_arch;
+    LARGE_INTEGER size;
+    DWORD read;
+    HANDLE file;
+    char *data = NULL;
+    int chars, skip = 0;
+    HRESULT hr = HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+
+    if (!GetModuleFileNameW( NULL, path, MAX_PATH )) return HRESULT_FROM_WIN32( GetLastError() );
+    if (FAILED(hr = PathCchRemoveFileSpec( path, ARRAY_SIZE(path) ))) return hr;
+    if (FAILED(hr = PathCchAppend( path, ARRAY_SIZE(path), L"AppxManifest.xml" ))) return hr;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!GetFileSizeEx( file, &size ) || !size.QuadPart || size.QuadPart > 16 * 1024 * 1024)
+    {
+        CloseHandle( file );
+        WARN( "Unexpected manifest size for %s.\n", debugstr_w(path) );
+        return HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    }
+    if (!(data = malloc( size.LowPart ))) { CloseHandle( file ); return E_OUTOFMEMORY; }
+    if (!ReadFile( file, data, size.LowPart, &read, NULL ) || read != size.LowPart)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        CloseHandle( file );
+        goto done;
+    }
+    CloseHandle( file );
+
+    if (read >= 3 && !memcmp( data, "\xef\xbb\xbf", 3 )) skip = 3;
+    hr = HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+    if (!(chars = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, data + skip, read - skip, NULL, 0 ))) goto done;
+    if (!(text = malloc( (chars + 1) * sizeof(WCHAR) ))) { hr = E_OUTOFMEMORY; goto done; }
+    MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, data + skip, read - skip, text, chars );
+    text[chars] = 0;
+
+    for (element = text; (element = wcsstr( element, L"<Identity" )); element++)
+        if (element[9] == ' ' || element[9] == '\t' || element[9] == '\r' || element[9] == '\n') break;
+    if (!element || !(end = wcschr( element, '>' )))
+    {
+        WARN( "No package Identity element in %s.\n", debugstr_w(path) );
+        goto done;
+    }
+    element += 9;
+    name = manifest_attribute( element, end, L"Name" );
+    manifest_version = manifest_attribute( element, end, L"Version" );
+    arch = manifest_attribute( element, end, L"ProcessorArchitecture" );
+    publisher = manifest_attribute( element, end, L"Publisher" );
+    if (!name || !manifest_version || !publisher) goto done;
+
+    swprintf( version, ARRAY_SIZE(version), L"%u.%u.%u.%u", id->version.Major, id->version.Minor,
+              id->version.Build, id->version.Revision );
+    expected_arch = architecture_name( id->processorArchitecture );
+    if (wcscmp( name, id->name ) || wcscmp( manifest_version, version ) || !expected_arch ||
+        wcsicmp( arch ? arch : L"neutral", expected_arch ))
+    {
+        WARN( "Manifest identity %s %s %s does not match package %s.\n", debugstr_w(name),
+              debugstr_w(manifest_version), debugstr_w(arch), debugstr_w(id->name) );
+        goto done;
+    }
+    if (FAILED(hr = publisher_id_from_publisher( publisher, publisher_id ))) goto done;
+    if (wcscmp( publisher_id, id->publisherId ))
+    {
+        WARN( "Manifest publisher id %s does not match package publisher id %s.\n",
+              debugstr_w(publisher_id), debugstr_w(id->publisherId) );
+        hr = HRESULT_FROM_WIN32( ERROR_INVALID_DATA );
+        goto done;
+    }
+    hr = WindowsCreateString( publisher, wcslen( publisher ), value );
+
+done:
+    free( name );
+    free( manifest_version );
+    free( arch );
+    free( publisher );
+    free( text );
+    free( data );
+    return hr;
+}
