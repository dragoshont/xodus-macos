+/******************************************************************************
+ *  RtlIsMultiSessionSku   (NTDLL.@)
+ *
+ * Native 26100 consults silo shared data (PEB->SharedData) first; Wine never
+ * creates silos, so only the KUSER_SHARED_DATA DbgMultiSessionSku bit applies.
+ */
+BOOLEAN WINAPI RtlIsMultiSessionSku(void)
+{
+    return user_shared_data->DbgMultiSessionSku;
+}
+
+/* Windows Notification Facility. Wine has no WNF publishers, so only state names measured as
+ * registered but never published on Windows 11 26100 are modelled: they have no data and change
+ * stamp 0, and subscriptions to them are never notified. Other names are reported as not found. */
+static const ULONGLONG unpublished_wnf_state_names[] =
+{
+    0x41950223a3bc1035, /* NLS scope, queried by MrmCoreR LanguageChangeNotifyThreadProc */
+    0x41950223a3bc2035, /* NLS scope, queried by MrmCoreR LanguageChangeNotifyThreadProc */
+};
+
+struct wnf_subscription
+{
+    ULONGLONG state_name;
+    void *callback;
+    void *context;
+};
+
+static BOOL is_unpublished_wnf_state_name( ULONGLONG name )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(unpublished_wnf_state_names); i++)
+        if (unpublished_wnf_state_names[i] == name) return TRUE;
+    return FALSE;
+}
+
+/***********************************************************************
+ *           NtQueryWnfStateData   (NTDLL.@)
+ */
+NTSTATUS WINAPI NtQueryWnfStateData( const ULONGLONG *name, const GUID *type_id, const void *scope,
+                                     ULONG *change_stamp, void *buffer, ULONG *size )
+{
+    TRACE( "(%p %p %p %p %p %p)\n", name, type_id, scope, change_stamp, buffer, size );
+
+    if (!name) return STATUS_ACCESS_VIOLATION;
+    if (!is_unpublished_wnf_state_name( *name ))
+    {
+        FIXME( "state name %s is not modelled\n", wine_dbgstr_longlong( *name ) );
+        return STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+    *change_stamp = 0;
+    *size = 0;
     return STATUS_SUCCESS;
 }
+
+/***********************************************************************
+ *           RtlSubscribeWnfStateChangeNotification   (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlSubscribeWnfStateChangeNotification( void **subscription, ULONGLONG name,
+                                                        ULONG change_stamp, void *callback, void *context,
+                                                        const GUID *type_id, ULONG serialization_group,
+                                                        ULONG flags )
+{
+    struct wnf_subscription *sub;
+
+    TRACE( "(%p %s %lu %p %p %p %lu %#lx)\n", subscription, wine_dbgstr_longlong( name ), change_stamp,
+           callback, context, type_id, serialization_group, flags );
+
+    if (!subscription || !callback) return STATUS_INVALID_PARAMETER;
+    if (!is_unpublished_wnf_state_name( name ))
+    {
+        FIXME( "state name %s is not modelled\n", wine_dbgstr_longlong( name ) );
+        return STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+    if (!(sub = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*sub) ))) return STATUS_NO_MEMORY;
+    sub->state_name = name;
+    sub->callback = callback;
+    sub->context = context;
+    *subscription = sub;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           RtlUnsubscribeWnfStateChangeNotification   (NTDLL.@)
+ */
+NTSTATUS WINAPI RtlUnsubscribeWnfStateChangeNotification( void *subscription )
+{
+    TRACE( "(%p)\n", subscription );
+
+    if (!subscription) return STATUS_INVALID_PARAMETER;
+    RtlFreeHeap( GetProcessHeap(), 0, subscription );
+    return STATUS_SUCCESS;
+}
