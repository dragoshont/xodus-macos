+/***********************************************************************
+ *         PsmQueryBackgroundActivationType   (kernelbase.@)
+ *
+ * Follows kernel.appcore 10.0.26100.9278: the first value of the WIN://BGKD
+ * token attribute, 1 when absent; cached for the current process token.
+ */
+NTSTATUS WINAPI PsmQueryBackgroundActivationType( HANDLE token, ULONG *type )
+{
+    struct bgkd_attribute
+    {
+        UNICODE_STRING name;
+        USHORT value_type, reserved;
+        ULONG flags, count;
+        ULONGLONG *values;
+    };
+    struct bgkd_attributes
+    {
+        USHORT version, reserved;
+        ULONG count;
+        struct bgkd_attribute *attributes;
+    } *info;
+    static LONG cached_type;
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"WIN://BGKD" );
+    ULONG size = 0x58, value = 1;
+    NTSTATUS status;
+    LONG cached;
+
+    TRACE( "(%p %p)\n", token, type );
+    if (token == GetCurrentProcessToken() && (cached = ReadNoFence( &cached_type )))
+    {
+        *type = cached;
+        return STATUS_SUCCESS;
+    }
+    if (!(info = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    status = NtQuerySecurityAttributesToken( token, &name, 1, info, size, &size );
+    if (status == STATUS_BUFFER_TOO_SMALL)
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, info );
+        if (!(info = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+        status = NtQuerySecurityAttributesToken( token, &name, 1, info, size, &size );
+    }
+    if (status == STATUS_NOT_FOUND) status = STATUS_SUCCESS;
+    else if (!status && info->count)
+    {
+        if (!info->attributes->count || !info->attributes->values) status = STATUS_INVALID_PARAMETER;
+        else value = (ULONG)info->attributes->values[0];
+    }
+    if (!status)
+    {
+        if (token == GetCurrentProcessToken()) InterlockedCompareExchange( &cached_type, value, 0 );
+        *type = value;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, info );
+    return status;
+}
