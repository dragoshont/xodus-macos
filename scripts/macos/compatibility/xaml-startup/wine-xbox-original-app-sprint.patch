+/* A thread owns one CoreMessaging completion port, shared by at most two of
+ * its windows; a slot is released when its window is destroyed. */
+static HWND coremsg_slot_window( struct user_thread_info *info, UINT slot )
+{
+    if (info->coremsg_hwnd[slot] && !is_current_thread_window( info->coremsg_hwnd[slot] ))
+        info->coremsg_hwnd[slot] = 0;
+    return info->coremsg_hwnd[slot];
+}
+
+/* CoreMessaging keeps a tagCoreMessagingTebEntry pointer in the last Win32ClientInfo slot
+ * (TEB+0x9e8 on x64): [0] notification callback, [1 + slot] singly linked list of signaled
+ * wait nodes whose first pointer is the link. */
+static ULONG_PTR *coremsg_teb_entry(void)
+{
+    return (ULONG_PTR *)NtCurrentTeb()->Win32ClientInfo[COREMSG_TEB_ENTRY_INDEX];
+}
+
+static UINT coremsg_first_slot( struct user_thread_info *info )
+{
+    UINT i;
+    for (i = 0; i < ARRAY_SIZE(info->coremsg_hwnd); i++) if (coremsg_slot_window( info, i )) return i;
+    return 0;
+}
+
+/* Remove one packet from the thread's CoreMessaging port, as measured on Windows 11 26100:
+ * - 32-bit ApcContext with bit 31 set: consumed silently (COREMSG_MARKER);
+ * - ApcContext 0 on a thread with a CoreMessaging TEB entry: the key is a wait node that is
+ *   pushed on the entry's list for the first slot (COREMSG_LINKED);
+ * - ApcContext 0 otherwise: message 0x60 (wparam 3, lparam 0) is sent to every registered
+ *   window and a message wait keeps waiting (COREMSG_NOWAKE);
+ * - any other ApcContext: message 0x60 (wparam 8, lparam ApcContext) is sent to every
+ *   registered window (COREMSG_DELIVERED). */
+int coremsg_dispatch_packet(void)
+{
+    struct user_thread_info *info = get_user_thread_info();
+    HWND hwnds[ARRAY_SIZE(info->coremsg_hwnd)];
+    ULONG_PTR key, apc, *entry;
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER zero;
+    WPARAM wparam = 8;
+    UINT i;
+
+    if (!info->coremsg_iocp) return COREMSG_EMPTY;
+    zero.QuadPart = 0;
+    if (NtRemoveIoCompletion( info->coremsg_iocp, &key, &apc, &io, &zero )) return COREMSG_EMPTY;
+    TRACE( "packet key %p apc %p status %#x info %p\n", (void *)key, (void *)apc, (UINT)io.Status, (void *)io.Information );
+    if ((ULONG)apc & 0x80000000) return COREMSG_MARKER;
+    if (!apc && (entry = coremsg_teb_entry()) && key)
+    {
+        UINT slot = coremsg_first_slot( info );
+        *(ULONG_PTR *)key = entry[1 + slot];
+        entry[1 + slot] = key;
+        return COREMSG_LINKED;
+    }
+    if (!apc) wparam = 3;
+    for (i = 0; i < ARRAY_SIZE(hwnds); i++) hwnds[i] = coremsg_slot_window( info, i );
+    for (i = 0; i < ARRAY_SIZE(hwnds); i++)
+        if (hwnds[i]) send_message( hwnds[i], WM_COREMSG_COMPLETION, wparam, (LPARAM)apc );
+    return apc ? COREMSG_DELIVERED : COREMSG_NOWAKE;
+}
