+/***********************************************************************
+ *         GetPackageResourcesProperty   (kernelbase.@)
+ */
+LONG WINAPI GetPackageResourcesProperty( void *context, UINT32 id, UINT32 *length, BYTE *buffer, UINT32 *flags )
+{
+    struct package_resources *res = current_package_resources;
+    struct package_resources_context *ctx = context;
+    UINT32 string_bytes, required;
+
+    TRACE( "(%p %u %p %p %p)\n", context, id, length, buffer, flags );
+    if (!ctx || !res || (ctx != &res->package && ctx != &res->application) || !length)
+        return ERROR_INVALID_PARAMETER;
+    if (!id || id > RESCTX_MAX_PROPERTY) return ERROR_INVALID_PARAMETER;
+    if (!ctx->values[id]) return ERROR_NOT_FOUND;
+    string_bytes = (wcslen( ctx->values[id] ) + 1) * sizeof(WCHAR);
+    if (string_bytes > 0xffff) return ERROR_INVALID_DATA;
+    required = (8 + string_bytes + 3) & ~3;
+    if (*length < required || !buffer)
+    {
+        *length = required;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memset( buffer, 0, required );
+    buffer[1] = 1;
+    memcpy( buffer + 2, &required, sizeof(required) );
+    buffer[6] = string_bytes & 0xff;
+    buffer[7] = string_bytes >> 8;
+    memcpy( buffer + 8, ctx->values[id], string_bytes );
+    *length = required;
+    if (flags) *flags = ctx->flags[id];
+    return ERROR_SUCCESS;
+}
