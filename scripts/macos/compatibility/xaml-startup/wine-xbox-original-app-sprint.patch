+static void test_server_send_lpc_requests(ULONG client_flags)
+{
+    static const WCHAR name_fmt[] = L"\\BaseNamedObjects\\wine_alpc_lpc_req_%lu_%lx";
+    HANDLE conn_port = NULL, comm_port = NULL, client_port = NULL;
+    ALPC_PORT_ATTRIBUTES port_attr;
+    TEST_ALPC_MESSAGE msg, recv_msg;
+    LARGE_INTEGER timeout;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    WCHAR buffer[96];
+    SIZE_T size;
+    NTSTATUS status;
+
+    swprintf(buffer, ARRAY_SIZE(buffer), name_fmt, GetCurrentProcessId(), client_flags);
+    RtlInitUnicodeString(&name, buffer);
+    InitializeObjectAttributes(&attr, &name, 0, NULL, NULL);
+    init_port_attr(&port_attr, ALPC_PORTFLG_ALLOW_LPC_REQUESTS | ALPC_PORTFLG_NON_BLOCKING_RECEIVE,
+                   sizeof(TEST_ALPC_MESSAGE));
+    status = pNtAlpcCreatePort(&conn_port, &attr, &port_attr);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+
+    init_port_attr(&port_attr, client_flags, sizeof(TEST_ALPC_MESSAGE));
+    fill_msg(&msg, "connect", sizeof("connect"), 0);
+    size = sizeof(msg);
+    status = pNtAlpcConnectPort(&client_port, &name, NULL, &port_attr, 0, NULL,
+                                (ALPC_PORT_MESSAGE *)&msg, &size, NULL, NULL, NULL);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+
+    timeout.QuadPart = -10000 * 1000;
+    memset(&recv_msg, 0, sizeof(recv_msg));
+    size = sizeof(recv_msg);
+    status = pNtAlpcSendWaitReceivePort(conn_port, 0, NULL, NULL, (ALPC_PORT_MESSAGE *)&recv_msg,
+                                        &size, NULL, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    init_port_attr(&port_attr, 0, sizeof(TEST_ALPC_MESSAGE));
+    status = pNtAlpcAcceptConnectPort(&comm_port, conn_port, 0, NULL, &port_attr, NULL,
+                                      (ALPC_PORT_MESSAGE *)&recv_msg, NULL, TRUE);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    memset(&recv_msg, 0, sizeof(recv_msg));
+    size = sizeof(recv_msg);
+    status = pNtAlpcSendWaitReceivePort(client_port, 0, NULL, NULL, (ALPC_PORT_MESSAGE *)&recv_msg,
+                                        &size, NULL, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(get_message_type(recv_msg.header.Type) == ALPC_MESSAGE_TYPE_CONNECTION_REPLY, "Got unexpected type %#x.\n",
+       recv_msg.header.Type);
+
+    /* A server communication port can only start a message when the client allows LPC requests */
+    fill_msg(&msg, "datagram", sizeof("datagram"), 0);
+    status = pNtAlpcSendWaitReceivePort(comm_port, ALPC_MSGFLG_REPLY_MESSAGE, (ALPC_PORT_MESSAGE *)&msg,
+                                        NULL, NULL, NULL, NULL, NULL);
+    if (!(client_flags & ALPC_PORTFLG_ALLOW_LPC_REQUESTS))
+    {
+        ok(status == STATUS_LPC_REQUESTS_NOT_ALLOWED, "Got unexpected status %#lx.\n", status);
+        goto done;
+    }
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    memset(&recv_msg, 0, sizeof(recv_msg));
+    size = sizeof(recv_msg);
+    status = pNtAlpcSendWaitReceivePort(client_port, 0, NULL, NULL, (ALPC_PORT_MESSAGE *)&recv_msg,
+                                        &size, NULL, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(get_message_type(recv_msg.header.Type) == ALPC_MESSAGE_TYPE_DATAGRAM, "Got unexpected type %#x.\n",
+       recv_msg.header.Type);
+    ok(!strcmp(recv_msg.data, "datagram"), "Got unexpected data %s.\n", debugstr_a(recv_msg.data));
+
+    fill_msg(&msg, "request", sizeof("request"), 0);
+    status = pNtAlpcSendWaitReceivePort(comm_port, 0, (ALPC_PORT_MESSAGE *)&msg, NULL, NULL, NULL, NULL, NULL);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    memset(&recv_msg, 0, sizeof(recv_msg));
+    size = sizeof(recv_msg);
+    status = pNtAlpcSendWaitReceivePort(client_port, 0, NULL, NULL, (ALPC_PORT_MESSAGE *)&recv_msg,
+                                        &size, NULL, &timeout);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(recv_msg.header.Type == (0x2000 | ALPC_MESSAGE_TYPE_REQUEST), "Got unexpected type %#x.\n",
+       recv_msg.header.Type);
+    ok(!strcmp(recv_msg.data, "request"), "Got unexpected data %s.\n", debugstr_a(recv_msg.data));
+
+done:
+    CloseHandle(client_port);
+    CloseHandle(comm_port);
+    CloseHandle(conn_port);
 }
 
