+/* Input activation objects (NtUserCreateActivationObject and friends), used by InputHost.dll
+ * for CoreWindow input sites. Semantics follow measurements of native Windows 11 26100: the
+ * handle is a USER handle, the id is opaque caller data, Destroy is idempotent. */
+struct activation_object
+{
+    HWND   hwnd;
+    UINT64 id;
+    UINT   flags;
+};
+
+static struct activation_object *get_activation_object_ptr( HANDLE handle )
+{
+    struct activation_object *obj = get_user_handle_ptr( handle, NTUSER_OBJ_ACTIVATION );
+
+    if (obj && obj != OBJ_OTHER_PROCESS) return obj;
+    if (obj) FIXME( "other process handle %p\n", handle );
+    RtlSetLastWin32Error( ERROR_NOT_FOUND );
+    return NULL;
+}
+
+BOOL create_activation_object( HWND hwnd, struct create_activation_object_params *params )
+{
+    struct activation_object *obj;
+    HANDLE handle;
+
+    TRACE( "hwnd %p id %s\n", hwnd, wine_dbgstr_longlong( params->id ));
+
+    if (!hwnd || !is_window( hwnd ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(obj = malloc( sizeof(*obj) ))) return FALSE;
+    obj->hwnd = get_full_window_handle( hwnd );
+    obj->id = params->id;
+    obj->flags = 0;
+    if (!(handle = alloc_user_handle( obj, NTUSER_OBJ_ACTIVATION )))
+    {
+        free( obj );
+        return FALSE;
+    }
+    params->handle = handle;
+    TRACE( "returning %p\n", handle );
+    return TRUE;
+}
+
+BOOL destroy_activation_object( HANDLE handle )
+{
+    struct activation_object *obj;
+
+    TRACE( "%p\n", handle );
+
+    /* native returns TRUE for any handle, including already destroyed ones */
+    obj = free_user_handle( handle, NTUSER_OBJ_ACTIVATION );
+    if (obj == OBJ_OTHER_PROCESS) FIXME( "other process handle %p\n", handle );
+    else free( obj );
+    return TRUE;
+}
+
+BOOL configure_activation_object( HANDLE handle, const struct configure_activation_object_params *params )
+{
+    struct activation_object *obj;
+
+    TRACE( "%p %lx %lx mask %#x value %#x\n", handle, (long)params->arg2, (long)params->arg3,
+           params->mask, params->value );
+
+    /* native rejects a nonzero second argument with ERROR_ACCESS_DENIED and a nonzero third
+     * argument with ERROR_INVALID_PARAMETER for an ordinary desktop process */
+    if (params->arg2)
+    {
+        FIXME( "unsupported arg2 %lx\n", (long)params->arg2 );
+        RtlSetLastWin32Error( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    if (params->arg3)
+    {
+        FIXME( "unsupported arg3 %lx\n", (long)params->arg3 );
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(obj = get_activation_object_ptr( handle ))) return FALSE;
+    obj->flags = (obj->flags & ~params->mask) | (params->value & params->mask);
+    release_user_handle_ptr( obj );
+    return TRUE;
+}
+
+BOOL set_activation_object_foreground_redirection( HANDLE handle, HWND hwnd )
+{
+    struct activation_object *obj;
+
+    TRACE( "%p %p\n", handle, hwnd );
+
+    if (!(obj = get_activation_object_ptr( handle ))) return FALSE;
+    release_user_handle_ptr( obj );
+    if (hwnd)
+    {
+        /* native rejects a redirection target window from an ordinary desktop process */
+        FIXME( "redirection to %p not supported\n", hwnd );
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
