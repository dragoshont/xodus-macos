+/***********************************************************************
+ *         VerifyPackageFullName   (kernelbase.@)
+ */
+LONG WINAPI VerifyPackageFullName( const WCHAR *full_name )
+{
+    UINT32 size = 0;
+
+    TRACE( "(%s)\n", debugstr_w(full_name) );
+
+    if (!full_name) return ERROR_INVALID_PARAMETER;
+    if (PackageIdFromFullName( full_name, 0, &size, NULL ) != ERROR_INSUFFICIENT_BUFFER)
+        return ERROR_INVALID_PARAMETER;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *         IsDeveloperModeEnabled   (kernelbase.@)
+ */
+HRESULT WINAPI IsDeveloperModeEnabled( BOOL *enabled )
+{
+    DWORD value = 0, size = sizeof(value);
+
+    TRACE( "(%p)\n", enabled );
+
+    if (!enabled) return E_POINTER;
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\AppModelUnlock",
+                      L"AllowDevelopmentWithoutDevLicense", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        value = 0;
+    *enabled = (value == 1);
+    return S_OK;
 }
