+static LSTATUS open_package_class_key(const WCHAR *classid, HKEY *key)
+{
+    static const WCHAR fmt[] = L"Software\\Classes\\ActivatableClasses\\Package\\%s\\ActivatableClassId\\%s";
+    WCHAR name[PACKAGE_FULL_NAME_MAX_LENGTH + 1], *path;
+    UINT32 len = ARRAY_SIZE(name);
+    LSTATUS ret;
+    size_t size;
+
+    if (GetCurrentPackageFullName(&len, name)) return ERROR_NOT_FOUND;
+    size = wcslen(fmt) + wcslen(name) + wcslen(classid) + 1;
+    if (!(path = malloc(size * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+    swprintf(path, size, fmt, name, classid);
+    ret = RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_READ, key);
+    if (!ret) TRACE("package class %s\n", debugstr_w(path));
+    free(path);
+    return ret;
+}
