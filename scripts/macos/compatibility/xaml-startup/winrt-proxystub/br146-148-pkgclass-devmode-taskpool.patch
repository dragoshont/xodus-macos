+/* Native shcore keeps these as plain globals consulted by its task pool. */
+static DWORD taskpool_reuse_thread_id;
+static BOOL taskpool_thread_reuse_allowed;
+
+/*************************************************************************
+ * SHTaskPoolAllowThreadReuse        [SHCORE.@]
+ *
+ * Native: void SHTaskPoolAllowThreadReuse(void) records GetCurrentThreadId().
+ */
+void WINAPI SHTaskPoolAllowThreadReuse(void)
+{
+    TRACE("thread %04lx\n", GetCurrentThreadId());
+    taskpool_reuse_thread_id = GetCurrentThreadId();
 }
+
+/*************************************************************************
+ * SHTaskPoolSetThreadReuseAllowed   [SHCORE.@]
+ *
+ * Native: void SHTaskPoolSetThreadReuseAllowed(BOOL) stores (allowed != 0).
+ */
+void WINAPI SHTaskPoolSetThreadReuseAllowed(BOOL allowed)
+{
+    TRACE("%d\n", allowed);
+    taskpool_thread_reuse_allowed = !!allowed;
+}
